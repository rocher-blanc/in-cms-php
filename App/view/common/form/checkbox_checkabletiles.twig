<div class="clear"></div>
<ul class="nomargin ui-sortable" id="list_{{ name }}_checkable_tiles">
    {% for id,row in option %}
        <label class="mini-img checkable-tile" id="checkabletile{{ id }}">
            <img src="{{ row.img }}" />
            <input type="checkbox" name="{{ name }}[]" value="{{ id }}" {% if id in value %}checked="checked"{% endif %}/>
            <i class="icon-line-check"></i>
        </label>
    {% endfor %}
    <li class="clear"></li>
</ul>
