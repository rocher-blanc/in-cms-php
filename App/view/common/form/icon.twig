<div class="list-icon">

    <input type="text" value="{{ value }}" class="form-control" name="{{ name }}" id="id_{{ name }}"/>

    <div class="list-icon-grid">
        {% for icon in listIcons %}
            <div class="icon{% if icon == value %} active{% endif %}" data-icon="{{ icon }}">
                <span class="{{ icon }}"></span>
            </div>
        {% endfor %}
    </div>

</div>