{% if hasFlag %}
<div style="margin-bottom:10px;" class="input-group input-group-icon">
    <span class="input-group-addon">
        <span class="icon">
            <i class="flag-icon flag-icon-{{ flag }}"></i>
        </span>
    </span>
{% endif %}
    <textarea
            class="form-control{{ editor ? ' wysiwyg' : '' }}"
            {% if editor %}
                data-url="{{ route( mod.name , 'editor' ) }}"
                data-editor-config="{{ editor_config }}"
            {% endif %}
            name="{{ name }}"
            id="id_{{ column }}"
    >{{ value }}</textarea>
{% if hasFlag %}
</div>
{% endif %}