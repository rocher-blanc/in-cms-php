<div class="clear"></div>
{% set col_number = 2 %}
{% set col_class = "col_half" %}
{% set number_in_part = ( option | length / col_number ) | round %}
{% set active_part = 0 %}

{% for key, val in option %}

    <label class="checkbox-tag-label">
        <input type="checkbox" value="{{ key }}" name="{{ name }}[]" {% if key in value %}checked="checked"{% endif %}>
        <span>{{ val }}</span>
    </label>

{% endfor %}