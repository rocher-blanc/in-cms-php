<div id="bloc_media_id_{{ name }}">
    <input type="hidden" name="{{ name }}" id="id_{{ name }}" value="{{ value }}" />
    <div class="scrollhimage">
        <div class="card">
            <img class="card-img-top" id="source_{{ field_name }}" src="{{ hasValue ? image : asset('canvas/img/nophoto.png') }}" data-empty="{{ asset('canvas/img/nophoto.png') }}" />
            <div class="card-body">
                <a href="{{ route( mod.name , 'libimages' ) }}?field_name={{ field_name }}&name={{ name }}" data-lightbox="ajax" class="button button-mini button-rounded button-amber"{# data-lib-picture class="button button-mini button-rounded button-amber" #}><i class="icon-picture"></i> Bibliothèque</a>
                <input id="upload_{{ name }}" value="{{ image }}" type="file" data-upload-image class="file-loading" data-fieldname="id_{{ name }}" data-imgname="source_{{ field_name }}" data-field="{{ field_name }}" data-uploadurl="{{ route( mod.name , 'upload' ) }}">
            </div>
        </div>
        <div class="clear"></div>
    </div>
</div>

{% if has_alt_img %}
    <div class="alt">
        {% for l in lang %}
            {% if lang|length == 1 %}
                <input type="text" value="{{ alt_img[ l.id ] }}" placeholder="Texte alternatif" class="form-control" name="alt_{{ name }}_{{ l.flag }}" id="id_alt_{{ name }}_{{ l.flag }}" />
            {% else %}
                <div class="input-group input-group-icon">
                    <span class="input-group-addon">
                        <span class="icon">
                            <i class="flag-icon flag-icon-{{ l.flag }}"></i>
                        </span>
                    </span>
                    <input type="text" value="{{ alt_img[ l.id ] }}" placeholder="Texte alternatif" class="form-control" name="alt_{{ name }}_{{ l.flag }}" id="id_alt_{{ name }}_{{ l.flag }}" />
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}