{#
<div id="bloc_media_id_{{ name }}">
    <input type="hidden" name="{{ name }}" id="id_{{ name }}" value="{{ value }}" />
    <div class="scrollhimage">
        <div class="card">
            <img class="card-img-top" id="source_{{ field_name }}" src="{{ hasValue ? image : asset('canvas/img/nophoto.png') }}" />
            <div class="card-body">
                <p class="card-text">Source</p>
                <a style="width: 142px;" href="{{ route( mod.name , 'media' ) }}?fieldid=id_{{ name }}&field={{ field_name }}&minwidth={{ minWidth }}&minheight={{ minHeight }}" class="button button-3d button-mini button-rounded" data-lightbox="ajax"><i class="icon-photo"></i> Sélectionner</a>
                {% if required == false %}
                    <a style="width: 142px;" class="button button-3d button-mini button-rounded button-red deleteMediaBtn" id="del_btn_id_{{ name }}" style="{{ value != '' ? '' : 'display:none; ' }}" data-field="{{ field_name }}" data-fieldid="id_{{ name }}"><i class="icon-trash2"></i>Supprimer</a>
                {% endif %}
            </div>
        </div>
        {% if crop|length %}
            {% for row in crop %}
                <div class="card card-crop"{{ hasValue ? '' : ' style="display: none;"' }}>
                    <img class="card-img-top" id="c_{{ field_name }}_{{ row.width }}x{{ row.height }}" src="{{ hasValue ? row.image : asset('canvas/img/nophoto.png') }}" data-url="{{ row.image }}" />
                    <div class="card-body">
                        <p class="card-text">Taille: {{ row.width }}x{{ row.height }}</p>
                        <a style="width: 142px;" class="button button-3d button-mini button-rounded openCrop" href="{{ row.href }}?height={{ row.height }}&width={{ row.width }}&field={{ field_name }}&id=c_{{ field_name }}_{{ row.width }}x{{ row.height }}" data-lightbox="ajax">
                            <i class="icon-crop2"></i>Recadrer
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
        <div class="clear"></div>
    </div>
</div>
#}
.
<div id="bloc_media_id_{{ name }}">
    <input type="hidden" name="{{ name }}" id="id_{{ name }}" value="{{ value }}" />
    <div class="scrollhimage">
        <div class="card">
            <img class="card-img-top" id="source_{{ field_name }}" src="{{ hasValue ? image : asset('canvas/img/nophoto.png') }}" data-empty="{{ asset('canvas/img/nophoto.png') }}" />
            <div class="card-body">
                <input id="upload_{{ name }}" value="{{ image }}" type="file" data-upload-image class="file-loading" data-fieldname="id_{{ name }}" data-imgname="source_{{ field_name }}" data-uploadurl="{{ route( mod.name , 'upload' ) }}">
            </div>
        </div>
        <div class="clear"></div>
    </div>
</div>

{% if has_alt_img %}
    <div class="alt">
        {% for l in lang %}
            {% if lang|length == 1 %}
                <input type="text" value="{{ alt_img[ l.id ] }}" placeholder="Texte alternatif" class="form-control" name="alt_{{ name }}_{{ l.flag }}" id="id_alt_{{ name }}_{{ l.flag }}" />
            {% else %}
                <div class="input-group input-group-icon">
                    <span class="input-group-addon">
                        <span class="icon">
                            <i class="flag-icon flag-icon-{{ l.flag }}"></i>
                        </span>
                    </span>
                    <input type="text" value="{{ alt_img[ l.id ] }}" placeholder="Texte alternatif" class="form-control" name="alt_{{ name }}_{{ l.flag }}" id="id_alt_{{ name }}_{{ l.flag }}" />
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}