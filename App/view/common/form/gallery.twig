<div class="list-gallery">
    <ul class="nomargin" id="list_gallery_{{ name }}" data-sortable-url="{{ route( mod.name , 'ordergallery' ) }}">
        {% if rst|length > 0 %}
            {% for key, img in rst %}
                <div class="mini-img" id="gallery-{{ key }}">
                    <img src="{{ img['100x100'] }}"/>
                    <div class="btn-bar">
                        <i class="icon-trash deletegallery" data-url="{{ route( mod.name , 'deletegallery' ) }}" data-image-id="{{ key }}"></i>&nbsp;&nbsp;<i class="icon-move movegallery"></i>&nbsp;&nbsp;
                    </div>
                </div>
            {% endfor %}
            <div class="clear"></div>
        {% endif %}
    </ul>
</div>
<div class="text-right">
    <input id="upload_{{ name }}" value="{{ image }}" type="file" data-upload-gallery class="file-loading" multiple data-field="{{ field_name }}__upload" data-hidden="{{ name }}" data-fieldname="{{ field_name }}" name="{{ field_name }}__upload[]" data-uploadurl="{{ route( mod.name , 'uploadgallery' ) }}">
</div>