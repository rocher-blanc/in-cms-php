<div class="input-group">
    <span class="input-group-addon">
        <i class="fa fa-calendar"></i>
    </span>
    <input type="text" data-plugin-{{ old ? 'old' : '' }}date{{ hour ? 'time' : '' }}picker{{ oldate ? 'oldate' : '' }} class="form-control" autocomplete="off" name="{{ name }}" id="id_{{ column }}" value="{{ value }}" />
</div>