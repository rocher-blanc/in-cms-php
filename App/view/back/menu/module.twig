{% for group in menuTree %}
    {% if group.children|length > 1 %}
        {% if group.open == true %}
            <ul class="sidenav">
                <li class="parent"><a href="#"><i class="{{ group.icon }}"></i>{{ group.name }}</a></li>
                {% for module in group.children %}
                    <li{% if module.selected == true %} class="ui-tabs-active ui-state-active"{% endif %}>
                        <a href="{{ route( module.class ) }}">
                            <i class="{{ module.icon }}"></i>{{ module.name }}<i class="icon-chevron-right"></i>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}
{% endfor %}