<div class="modal1" id="myModal1">
    <div class="block divcenter" style="background-color: #fff; max-width: 932px;">
        <div class="title-modal">
            <div class="col_half nomargin"><h3>Recadrage d'une image</h3></div>
            <div class="col_half col_last nomargin" style="width: 52%; color: #fff; text-align: right;">
                <span style="float: right;" class="button button-3d button-mini button-rounded fileinput-button saveCrop" id="btn-upload">
                    <i class="icon-save"></i> Sauvegarder
                </span>
            </div>
            <div class="clear"></div>
        </div>
        <div class="content content-modal" id="content-media">
            <img src="{{ siteUrl( path ~ '/' ~ imageName , false ) }}" id="cropimage" data-height="{{ height }}" data-fieldid="{{ fieldid }}" data-width="{{ width }}" data-field="{{ field }}" />
            <form id="formCropImage" action="{{ route( mod.name , 'cropimage' ) }}" method="post">
                <input type="hidden" name="image" id="image" value="{{ path }}/{{ imageName }}" />
                <input type="hidden" name="imageName" id="imageName" value="{{ imageName }}" />
                <input type="hidden" name="field" id="field" value="{{ field }}" />
                <input type="hidden" name="crop_x" id="crop_x" value="0" />
                <input type="hidden" name="crop_y" id="crop_y" value="0" />
                <input type="hidden" name="crop_x2" id="crop_x2" value="0" />
                <input type="hidden" name="crop_y2" id="crop_y2" value="0" />
                <input type="hidden" name="crop_width" id="crop_width" value="0" />
                <input type="hidden" name="crop_height" id="crop_height" value="0" />
                <input type="hidden" id="token" name="{{csrf_key}}" value="{{csrf_token}}" />
            </form>
        </div>
    </div>
</div>
<script>
    cropImage();
</script>