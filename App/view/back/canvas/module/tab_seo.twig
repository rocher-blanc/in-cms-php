<form name="form" method="post" action="{{ siteUrl('/module/' ~ mod.name ~ '/' ~ action ~ '/' ~ id ) }}" role="form" class="form-horizontal group-border-dashed">
    <input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}" />
    <div class="ed_field col_full">
        <label>Title</label>
        {% for l in lang %}
            <div style="margin-bottom:10px;" class="input-group input-group-icon">
                                <span class="input-group-addon">
                                    <span class="icon">
                                        <i class="flag-icon flag-icon-{{ l.flag }}"></i>
                                    </span>
                                </span>
                <input type="text" data-plugin-counter="55" name="seo_title_{{ l.url }}" value="{{ content[ l.url ]['title'] }}" class="form-control" />
            </div>
        {% endfor %}
    </div>
    <div class="ed_field col_full">
        <label>Description</label>
        {% for l in lang %}
            <div style="margin-bottom:10px;" class="input-group input-group-icon">
                                <span class="input-group-addon">
                                    <span class="icon">
                                        <i class="flag-icon flag-icon-{{ l.flag }}"></i>
                                    </span>
                                </span>
                <input type="text" data-plugin-counter="115" name="seo_description_{{ l.url }}" value="{{ content[ l.url ]['description'] }}" class="form-control" />
            </div>
        {% endfor %}
    </div>
    <div class="ed_field col_full">
        <label>Url</label>
        {% for l in lang %}
            <div style="margin-bottom:10px;" class="input-group input-group-icon">
                                <span class="input-group-addon">
                                    <span class="icon">
                                        <i class="flag-icon flag-icon-{{ l.flag }}"></i>
                                    </span>
                                </span>
                <input type="text" name="seo_url_{{ l.url }}" value="{{ content[ l.url ]['url'] }}" class="form-control" />
                <input type="hidden" name="seo_last_url_{{ l.url }}" value="{{ content[ l.url ]['url'] }}" />
            </div>
        {% endfor %}
    </div>
    <div class="ed_field col_full">
        <label>Indexer</label>
        <input value="1" type="checkbox"{{ index == 1 ? ' checked="checked"' : '' }} data-plugin-ios-switch name="index" id="index" />
    </div>
    <div class="ed_field col_full">
        <button class="ed-button button button-rounded button-reveal button-large button-3d"><i class="icon-save"></i><span>Enregistrer</span></button>
    </div>
</form>