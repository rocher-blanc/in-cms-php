{% extends 'module.twig.html' %}

{% block title_page %}{{ _('pages')}}{% endblock %}
{% set this_page = _('gestion') %}

{% block module %}
    <div class="fancy-title title-dotted-border">
        <h3>{{ _('liste_pages')}}</h3>
    </div>
    <div class="ed-menu">
        <a href="{{ siteUrl('admin/pageadmin/edit') }}" class="button button-mini"><i class="icon-plus"></i>{{ _('button_add')}}</a>
    </div>
    <br />
    <div class="table-responsive">
    {% if content|length > 0 %}
        <table class="table table-striped table-hover mb-none">
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>{{ _('nom')}}</th>
                    <th>{{ _('default')}}</th>
                    <th>{{ _('indexed')}}</th>
                    <th>{{ _('status')}}</th>
                    <th class="text-right" style="width: 120px"></th>
                </tr>
            </thead>
            <tbody>
            {% if domain == true %}
                {% for domain in content if domain.page | length > 0 %}
                    <tr class="tr1">
                        <th colspan="6" class="text-center"><strong>{{ domain.name }}</strong></th>
                    </tr>
                    {% for row in domain.page %}
                        <tr class="tr1">
                            <td>
                                #{{ row.page_id }}
                            </td>
                            <td>
                                <a href="{{ siteUrl('admin/pageadmin/edit/' ~  row.page_id) }}">{{ row.page_name }}</a>
                            </td>
                            <td>
                                {% if row.page_default == 1 %}
                                    <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('default_page')}}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if row.page_index == 0 %}
                                    <span class="button button-3d button-mini button-rounded button-amber disabled">{{ _('non')}}</span>
                                {% else %}
                                    <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('oui')}}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if row.page_active == 0 %}
                                    <span class="button button-3d button-mini button-rounded button-amber disabled">{{ _('disable')}}</span>
                                {% else %}
                                    <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('activated')}}</span>
                                {% endif %}
                            </td>
                            <td class="text-right">
                                <a href="{{ siteUrl('admin/pageadmin/edit/' ~ row.page_id) }}"><i class="icon-pencil"></i></a>
                            </td>
                        </tr>
                    {% endfor %}
                {% endfor %}
            {% else %}
                {% for row in content %}
                    <tr class="tr1">
                        <td>
                            #{{ row.page_id }}
                        </td>
                        <td>
                            <a href="{{ siteUrl('admin/pageadmin/edit/' ~  row.page_id) }}">{{ row.page_name }}</a>
                        </td>
                        <td>
                            {% if row.page_default == 1 %}
                                <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('default_page')}}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if row.page_index == 0 %}
                                <span class="button button-3d button-mini button-rounded button-amber disabled">{{ _('non')}}</span>
                            {% else %}
                                <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('oui')}}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if row.page_active == 0 %}
                                <span class="button button-3d button-mini button-rounded button-amber disabled">{{ _('disable')}}</span>
                            {% else %}
                                <span class="button button-3d button-mini button-rounded button-green disabled">{{ _('activated')}}</span>
                            {% endif %}
                        </td>
                        <td class="text-right">
                            <a href="{{ siteUrl('admin/pageadmin/edit/' ~ row.page_id) }}"><i class="icon-pencil"></i></a>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
    {% else %}
        {% include 'form/generic/nocontent.twig' with {'msg': _('page_index_msg')} %}
    {% endif %}
    </div>

{% endblock %}