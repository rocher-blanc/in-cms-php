{% extends 'module.twig.html' %}

{% block title_page %}{{ _('pages')}}{% endblock %}

{% if id != -1 %}
	{% set this_page = _('modification') %}
	{% set title_block_page = _('page_edit_modif') %}
{% else %}
	{% set this_page = _('ajout') %}
	{% set title_block_page = _('page_edit_add') %}
{% endif %}

{% block module %}
<form method="post" action="{{ siteUrl('admin/pageadmin/edit') }}{% if id != -1 %}/{{ id }}{% endif %}" class="form-vertical">
	<input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}" />
    <input type="hidden" name="page_domain_id" value="0" />
    <input type="hidden" name="page_access_user_redirect" value="0" />

    <div class="fancy-title title-dotted-border">
        <h3>{{ title_block_page }}</h3>
    </div>

    <div class="ed-menu">
        <a href="{{ siteUrl('admin/pageadmin') }}" class="button button-mini"><i class="icon-th-list"></i>{{ _('button_manage')}}</a>
    </div>
    <br />

    <div class="tab-content">
        <div class="tab-pane active panel-body">

            <div class="ed_field col_half">
                <label>{{ _('activated_m')}}</label>
                {% include 'form/generic/switch.twig' with {'value':post.page_active, 'name':'page_active'} %}
            </div>
            <div class="ed_field col_half col_last">
                <label>{{ _('nom_interne')}}</label>
                <input type="text" id="page_name" name="page_name" class="form-control" value="{{ post.page_name }}" />
            </div>
            {% if domains | length > 0 %}
                <div class="ed_field col_half">
                    <label>{{ _('domaine')}}</label>
                    <select id="page_domain_id" name="page_domain_id" class="form-control">
                        {% for domain in domains %}
                            <option value="{{ domain.id }}"{% if domain.selected %} selected="selected"{% endif %}>{{ domain.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="clear"></div>
            {% endif %}
            {% if active_user == true %}
                <div class="clear"></div>
                <div class="fancy-title title-bottom-border">
                    <h3>{{ _('user_security')}}</h3>
                </div>
                <div class="ed_field col_one_third">
                    <label>{{ _('user_access')}}</label>
                    <select name="page_access_user" id="page_access_user" class="form-control">
                        <option value="0"{{ post.page_access_user == 0 ? ' selected' : '' }}>{{ _('connectes_&_non')}}</option>
                        <option value="1"{{ post.page_access_user == 1 ? ' selected' : '' }}>{{ _('non_connectes')}}</option>
                        <option value="2"{{ post.page_access_user == 2 ? ' selected' : '' }}>{{ _('connectes')}}</option>
                    </select>
                </div>
                {% if id != -1 %}
                <div class="ed_field col_one_third">
                    <label>{{ _('page_redirect')}}</label>
                    <div class="comment">{{ _('page_redirect_comment')}}</div>
                    <select name="page_access_user_redirect" id="page_access_user_redirect" class="form-control">
                        <option value="0"{{ post.page_access_user_redirect == 0 ? ' selected' : '' }}>--- {{ _('no_redirect')}} ---</option>
                        {% for pageRedir in pageRedirect %}
                            <option value="{{ pageRedir.page_id }}"{{ post.page_access_user_redirect == pageRedir.page_id ? ' selected' : '' }}>{{ pageRedir.page_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="ed_field col_one_third col_last">
                    <label for="id_page_access_user_group">{{ _('allowed_grp_user')}}</label>
                    <select name="page_access_user_group[]" id="id_page_access_user_group" data-plugin-selectPicker data-size="10" multiple title="{{ _('option_select')}}">
                        {% for group in groups %}
                            <option value="{{ group.user_front_group_id }}"{% if group.user_front_group_id in post.page_access_user_group %} selected="selected"{% endif %}>{{ group.user_front_group_name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            {% include 'form/generic/button.twig' %}
        </div>
    </div>
</form>
{% endblock %}


{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('canvas/js/components/bs-select.js') }}"></script>
    <script src="{{ asset('canvas/js/easydoor/form.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('canvas/css/src/components/bs-select.css') }}" />
{% endblock %}