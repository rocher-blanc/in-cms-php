{% extends 'module.twig.html' %}

{% block title_page %}{{ _('modules')}}{% endblock %}
{% set this_page = _('moduleadmin_new') %}

{% block module %}

    {# TODO dynamiser les relations {{ dump(depedency) }} #}
    {# TODO dynamiser les relations {{ dump(module) }} #}

    {# TODO [v2] Pour le manyToMany (select) des modules (variable many) (select manuel ou auto) #}

    <style>
        .border-danger { border-color: #a94442 }
        .modal-header:before, .modal-header:after { content: none }
        .modal-hide { display: none }
    </style>

    {{ dump(depedency) }}
    {{ dump(module) }}

    <div id="app">

        <h4 style="margin-bottom: 20px">Paramètres du module</h4>

        <div class="card card-body" style="margin-bottom: 30px">

            <div class="form-group row">
                <label class="col-sm-3">Nom</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" v-model="globalParams.name">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Édition</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.delete">
                                delete
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.edit">
                                edit
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.add">
                                add
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.valid">
                                valid
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Ordonner les éléments</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.order">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Type de module</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-3">
                            <label>
                                <input type="radio" v-model="globalParams.type" value="standard">
                                Standard
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="radio" v-model="globalParams.type" value="user_profile">
                                Profil utilisateur
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="radio" v-model="globalParams.type" value="user_association">
                                Associer à un utilisateur
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Nombre maximum d'éléments</label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" v-model="globalParams.limit">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Nombre par page</label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" v-model="globalParams.pagination">
                </div>
            </div>

            <div class="form-group row" v-if="!globalParams.hasDepedency">
                <label class="col-sm-3">Ce module est une dépendance</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.isDepedency">
                </div>
            </div>

            <div class="form-group row" v-if="!globalParams.isDepedency">
                <label class="col-sm-3">Ce module a des dépendances</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.hasDepedency">
                </div>
            </div>

            <div class="form-group row" v-if="globalParams.hasDepedency">
                <label class="col-sm-3">Choisir les dépendances</label>
                <div class="col-sm-9">
                    <select class="form-control" multiple v-model="globalParams.depedencies">
                        <option value="moduleA">module A</option>
                        <option value="moduleB">module B</option>
                        <option value="moduleC">module C</option>
                    </select>
                </div>
            </div>
        </div>

        <h4 style="margin-bottom: 20px">Nouveau champ</h4>

        <div class="card card-body" style="margin-bottom: 30px">

            <div class="form-group row">
                <label class="col-sm-3">Groupe</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-3">
                            <select class="form-control" :disabled="!groups.length" v-model="newField.groupId">
                                <option value="">Aucun groupe</option>
                                <option v-for="group in groups" :value="group.id"><-- group.name --></option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-secondary btn-block" @click="toggleModal('addNewGroup')">
                                + Ajouter un groupe
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Onglet</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-3">
                            <select class="form-control" :disabled="!tabs.length" v-model="newField.tabId">
                                <option value="">Aucun onglet</option>
                                <option v-for="tab in tabs" :value="tab.id"><-- tab.name --></option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-secondary btn-block" @click="toggleModal('addNewTab')">
                                + Ajouter un onglet
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Id du champ</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" :class="{ 'border-danger' : duplicatedId }" v-model="newField.id">
                    <div class="text-danger" v-if="duplicatedId">Cet ID est déjà utilisé par un autre champ</div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Nom du champ</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" v-model="newField.name">
                </div>
            </div>

            <div class="form-group row" v-if="!hasUrl">
                <label class="col-sm-3">Créer l'url à partir du nom</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="newField.isUrl">
                </div>
            </div>

            <div class="form-group row" v-if="!hasUrl">
                <label class="col-sm-3">Ajouter comme référence</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="newField.isRef">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Champ obligatoire</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="newField.empty">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Commentaire</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" v-model="newField.comment">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Taille du champ</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-6" v-if="newField.column.total">
                            Largeur
                            <select class="form-control" v-model="newField.column.size" style="margin-top: 5px">
                                <option v-for="col in maxCols" v-if="col <= newField.column.total" :value="col"><-- col --></option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            Total
                            <select class="form-control" v-model="newField.column.total" style="margin-top: 5px">
                                <option v-for="col in maxCols" :value="col"><-- col --></option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Type de champ</label>
                <div class="col-sm-9">
                    <select name="type" v-model="newField.type" class="form-control">
                        <option v-for="fieldType in fieldTypes" :value="fieldType.value"><-- fieldType.text --></option>
                    </select>
                </div>
            </div>

            <div class="form-group row" v-if="newField.type === 'input'">
                <label class="col-sm-3">Type d'input</label>
                <div class="col-sm-9">
                    <select name="type" v-model="newField.inputType" class="form-control">
                        <option v-for="inputType in inputTypes" :value="inputType.value"><-- inputType.text --></option>
                    </select>
                </div>
            </div>

            <div class="form-group row" v-if="newField.type === 'input'">
                <label class="col-sm-3">Taille du champ</label>
                <div class="col-sm-9">
                    <input class="form-control" type="number" v-model="newField.inputCharLength">
                </div>
            </div>

            <div class="form-group row" v-if="['input','textarea'].includes(newField.type)">
                <label class="col-sm-3">Activer le multilang</label>
                <div class="col-sm-9">
                    <input type="checkbox" class="form-check-input" v-model="newField.lang">
                </div>
            </div>

            <div class="form-group row" v-if="newField.type === 'textarea'">
                <label class="col-sm-3">Activer l'éditeur HTML</label>
                <div class="col-sm-9">
                    <input type="checkbox" class="form-check-input" v-model="newField.textareaHtml">
                </div>
            </div>

            <div class="form-group row" v-if="['select','radio','checkbox','date'].includes(newField.type)">
                <label class="col-sm-3">Liste des options</label>
                <div class="col-sm-9">
                    <div class="row" v-if="newField.selectOptions.length" v-for="(selectOption, index) in newField.selectOptions" style="margin-bottom: 10px">
                        <div class="col-sm-5">
                            <input type="text" class="form-control" readonly v-model="selectOption.key">
                        </div>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" readonly v-model="selectOption.value">
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-secondary btn-block" @click="removeOption(index)">Remove</button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-5">
                            <input type="text" class="form-control" placeholder="key" v-model="newField.option.key">
                        </div>
                        <div class="col-sm-5">
                            <input type="text" class="form-control" placeholder="value" v-model="newField.option.value">
                        </div>
                        <div class="col-sm-2">
                            <button class="btn btn-primary btn-block" @click="addOption()" :disabled="!optionValidation">Add</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row" v-if="newField.type === 'date'">
                <label class="col-sm-3">Activer l'heure</label>
                <div class="col-sm-9">
                    <input type="checkbox" class="form-check-input" v-model="newField.dateWithHour">
                </div>
            </div>

            <div class="form-group row" v-if="['image','gallery'].includes(newField.type)">
                <label class="col-sm-3">Options d'image</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-4">
                            Type
                            <select class="form-control" v-model="newField.imageType" style="margin-top: 5px">
                                <option v-for="imageType in imageTypes" :value="imageType">
                                    <-- imageType -->
                                </option>
                            </select>
                        </div>
                        <div class="col-sm-4" v-if="newField.imageType !== 'height'">
                            Width
                            <input class="form-control" type="text" v-model="newField.imageWidth" style="margin-top: 5px">
                        </div>
                        <div class="col-sm-4" v-if="newField.imageType !== 'width'">
                            Height
                            <input class="form-control" type="text" v-model="newField.imageHeight" style="margin-top: 5px">
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row" v-if="['integer','float'].includes(newField.type)">
                <label class="col-sm-3">Step</label>
                <div class="col-sm-9">
                    <input class="form-control" type="number" class="form-check-input" v-model="newField.intStep">
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12 text-right">
                    <button @click="addField" class="btn btn-primary" :disabled="!formValidation">Ajouter le champ</button>
                </div>
            </div>
        </div>

        <div v-if="fields.length" v-for="(field, index) in fields" class="card card-body" style="margin-bottom: 15px">
            <div class="text-right" style="margin-bottom: 10px">
                <button class="btn btn-sm btn-danger" @click="remove(index)"><i class="icon-line-trash"></i></button>
                <button class="btn btn-sm btn-secondary" v-if="index !== 0" @click="moveUp(index)"><i class="icon-line-arrow-up"></i></button>
                <button class="btn btn-sm btn-secondary" v-if="index !== fields.length - 1" @click="moveDown(index)"><i class="icon-line-arrow-down"></i></button>
            </div>
            <div class="row">
                <div class="col-sm-2">
                    <strong>Position</strong><br>
                    <-- index + 1 -->
                </div>
                <div class="col-sm-1">
                    <strong>Taille</strong><br>
                    <-- field.column.size --> / <-- field.column.total -->
                </div>
                <div class="col-sm-1">
                    <strong>Id</strong><br>
                    <-- field.id -->
                </div>
                <div class="col-sm-1">
                    <strong>Nom</strong><br>
                    <-- field.name -->
                </div>
                <div class="col-sm-1">
                    <strong>Type</strong><br>
                    <-- field.type -->
                </div>
                <div class="col-sm-1">
                    <display-boolean :value="field.groupId" text="Groupe"></display-boolean>
                    <div v-if="field.groupId">Id: <-- field.groupId --></div>
                </div>
                <div class="col-sm-1">
                    <display-boolean :value="field.tabId" text="Onglet"></display-boolean>
                    <div v-if="field.tabId">Id: <-- field.tabId --></div>
                </div>
                <div class="col-sm-2">
                    <display-boolean :value="field.isUrl" text="Url à partir du nom"></display-boolean>
                    <display-boolean :value="field.isUrl" text="Ajouté comme référence"></display-boolean>
                    <display-boolean :value="field.empty" text="Champ obligatoire"></display-boolean>
                    <div v-if="field.comment">
                        <div>Commentaire: <-- field.comment --></div>
                    </div>
                </div>
                <div class="col-sm-2" v-if="['textarea','select','radio','checkbox','date','image','gallery','integer','float','input'].includes(field.type)">
                    <strong>Options</strong><br>
                    <display-boolean v-if="['textarea'].includes(field.type)" :value="field.textareaHtml" text="Éditeur HTML"></display-boolean>
                    <display-boolean v-if="['textarea','input'].includes(field.type)" :value="field.lang" text="Multilang"></display-boolean>
                    <display-boolean v-if="['integer','float'].includes(field.type)" :value="field.intStep" :text="'Step '+field.intStep"></display-boolean>
                    <display-boolean v-if="['date'].includes(field.type)" :value="field.dateWithHour" text="Avec heure"></display-boolean>
                    <div v-if="['select','radio','checkbox','date'].includes(field.type)">
                        <div v-for="option in field.selectOptions"><-- option --></div>
                    </div>
                    <div v-if="['image','gallery'].includes(field.type)">
                        <div>Type: <-- field.imageType --></div>
                        <div v-if="field.imageWidth">Width: <-- field.imageWidth --></div>
                        <div v-if="field.imageHeight">Height: <-- field.imageHeight --></div>
                    </div>
                    <div v-if="['input'].includes(field.type)">
                        <div>Type d'input: <-- field.inputType --></div>
                        <div>Taille du champ: <-- field.inputCharLength --></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center">
            <button @click="saveJson" class="btn btn-lg btn-primary" :disabled="!(fields.length && globalParams.name.length && !modules.includes(globalParams.name))">Sauvegarder</button>
        </div>

        {% for modal in ['tab','group'] %}
            {% set id = modal == 'group' ? 'addNewGroup' : 'addNewTab' %}
            {% set title = modal == 'group' ? 'Ajouter un groupe' : 'Ajouter un onglet' %}
            {% set method = modal == 'group' ? 'addGroup' : 'addTab' %}
            <div id="{{ id }}" class="modal-hide" style="position: fixed; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,.7); z-index: 1000;">
                <div class="modal" style="display: flex; align-items: center">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header" style="display: flex; justify-content: space-between">
                                <h5 class="modal-title">{{ title }}</h5>
                                <button type="button" class="close" @click="toggleModal('{{ id }}')">
                                    <span>&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                {% if modal == 'group' %}
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <label for="groupId">Id</label>
                                            <input id="groupId" class="form-control" type="text" v-model="newGroup.id">
                                        </div>
                                        <div class="col-sm-6">
                                            <label for="groupName">Nom</label>
                                            <input id="groupName" class="form-control" type="text" v-model="newGroup.name">
                                        </div>
                                    </div>
                                {% elseif modal == 'tab' %}
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <label for="groupId">Id</label>
                                            <input id="groupId" class="form-control" type="text" v-model="newTab.id">
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="groupName">Nom</label>
                                            <input id="groupName" class="form-control" type="text" v-model="newTab.name">
                                        </div>
                                        <div class="col-sm-4">
                                            <label for="groupName">Icone</label>
                                            <input id="groupName" class="form-control" type="text" v-model="newTab.icon">
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="modal-footer" style="border: 0">
                                <button type="button" class="btn btn-primary" @click="{{ method }}">Sauvegarder</button>
                                <button type="button" class="btn btn-secondary" @click="toggleModal('{{ id }}')">Fermer</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts_end %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/vue/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.20.0/axios.min.js"></script>
    <script>
        Vue.component('display-boolean', {
            delimiters: ["<--","-->"],
            props: ['value','text'],
            computed: {
                icon() { return this.value ? 'icon-line-check' : 'icon-line-cross' },
                color() { return this.value ? 'text-success' : 'text-warning' }
            },
            template: `<div><strong :class="color"><i :class="icon"></i> <-- text --></strong></div>`
        });
        const app = new Vue({
            el: '#app',
            delimiters: ["<--","-->"],
            data: {
                modules: [
                  {% for m in module %}
                    '{{ m.name }}',
                  {% endfor %}
                ],
                fieldTypes: [
                    { value: 'input', text: 'Input' },
                    { value: 'select', text: 'Select' },
                    { value: 'textarea', text: 'Textarea' },
                    { value: 'gallery', text: 'Galerie' },
                    { value: 'document', text: 'Documents' },
                    { value: 'video', text: 'Video' },
                    { value: 'link', text: 'Lien' },
                    { value: 'image', text: 'Image' },
                    { value: 'radio', text: 'Radio' },
                    { value: 'checkbox', text: 'Checkbox' },
                    { value: 'boolean', text: 'Boolean' },
                    { value: 'integer', text: 'Chiffre entier' },
                    { value: 'float', text: 'Chiffre avec décimale' },
                    { value: 'icon', text: 'Icone' },
                    { value: 'password', text: 'Mot de passe' },
                    { value: 'date', text: 'Date' },
                    { value: 'hour', text: 'Heure' }
                ],
                inputTypes: [
                    { value: 'text', text: 'Text' },
                    { value: 'phone', text: 'Phone' },
                    { value: 'email', text: 'Email' }
                ],
                imageTypes: ['thumb','cover','width','height'],
                maxCols: 5,
                newGroup: {
                  id: '',
                  name: ''
                },
                newTab: {
                  id: '',
                  name: '',
                  icon: ''
                },
                newField: {
                    id: '',
                    name: '',
                    groupId: '',
                    tabId: '',
                    isUrl: false,
                    isRef: false,
                    empty: false,
                    many: false,
                    lang: false,
                    comment: '',
                    column: {
                        size: 5,
                        total: 5
                    },
                    type: '',
                    inputType: '',
                    inputCharLength: 255,
                    textareaHtml: false,
                    selectOptions: [],
                    option: {
                        key: '',
                        value: ''
                    },
                    imageType: '',
                    imageWidth: 0,
                    imageHeight: 0,
                    intStep: 0,
                    dateWithHour: false
                },
                /* DATA DYNAMIQUE */
                globalParams: {
                    edition: {
                        delete: true,
                        edit: true,
                        add: true,
                        valid: false
                    },
                    name: '',
                    type: 'standard',
                    order: false,
                    limit: false,
                    pagination: false,
                    isDepedency: false,
                    hasDepedency: false,
                    depedencies: []
                },
                fields: [],
                tabs: [],
                groups: []
            },
            computed: {
                formValidation() {
                    const basicDatasFilled =
                        !this.duplicatedId &&
                        this.newField.id.length &&
                        this.newField.name.length &&
                        this.newField.column.size &&
                        this.newField.column.total &&
                        this.newField.type.length > 0;
                    if (['select','radio','checkbox','date'].includes(this.newField.type)) {
                        return basicDatasFilled && this.newField.selectOptions.length > 1;
                    } else if (['image','gallery'].includes(this.newField.type)) {
                        if (['width'].includes(this.newField.imageType)) {
                            return basicDatasFilled && this.newField.imageType.length > 0 && this.newField.imageWidth;
                        } else if (['height'].includes(this.newField.imageType)) {
                            return basicDatasFilled && this.newField.imageType.length > 0 && this.newField.imageHeight;
                        } else {
                            return basicDatasFilled && this.newField.imageType.length > 0 && this.newField.imageWidth && this.newField.imageHeight;
                        }
                    } else if (['input'].includes(this.newField.type)) {
                        return basicDatasFilled && this.newField.inputType.length > 1;
                    } else {
                        return basicDatasFilled;
                    }
                },
                optionValidation() {
                    return (this.newField.option.key.length > 0 && this.newField.option.value.length > 0);
                },
                hasUrl() {
                    const result = this.fields.filter(field => field.isUrl);
                    return result.length;
                },
                refs() {
                    let fieldsId = [];
                    const filteredFields = this.fields.filter(field => field.isRef);
                    filteredFields.forEach(field => fieldsId.push(field.id));
                    return fieldsId;
                },
                duplicatedId() {
                    let result = false;
                    this.fields.forEach(field => {
                        if (field.id === this.newField.id) { result = true }
                    });
                    return result;
                }
            },
            methods: {
                toggleModal(modalId) {
                  document.getElementById(modalId).classList.toggle('modal-hide');
                },
                addGroup() {
                  this.groups.push(JSON.parse(JSON.stringify(this.newGroup)));
                  this.toggleModal('addNewGroup');
                },
                addTab() {
                  this.tabs.push(JSON.parse(JSON.stringify(this.newTab)));
                  this.toggleModal('addNewTab');
                },
                addField () {
                    this.newField.id = this.camelCase(this.newField.id);
                    this.fields.push(JSON.parse(JSON.stringify(this.newField)));
                },
                saveJson: function () {
                    axios.post('{{ siteUrl('admin/moduleadmin/generate') }}', {
                        {{csrf_key}}:'{{csrf_token}}',
                        tabs: JSON.stringify(this.tabs),
                        groups: JSON.stringify(this.groups),
                        fields: JSON.stringify(this.fields),
                        global: JSON.stringify(this.globalParams)
                    })
                    .then(function (response) {
                       // document.location.href='{{ siteUrl('admin/moduleadmin') }}';
                    })
                    .catch(function (error) {
                        console.log(error);
                    });
                },
                addOption() {
                    this.newField.selectOptions.push(
                        JSON.parse(JSON.stringify({
                            key: this.camelCase(this.newField.option.key),
                            value: this.newField.option.value
                        }))
                    )
                },
                removeOption(index) {
                    this.newField.selectOptions.splice(index);
                },
                moveUp(index) {
                    if (index !== 0) {
                        this.fields = this.fields.map((e, i) => {
                            if (i === index - 1) {
                                return this.fields[index];
                            } else if (i === index) {
                                return this.fields[index - 1];
                            } else {
                                return e;
                            }
                        })
                    }
                },
                moveDown(index) {
                    if (index !== this.fields.length-1) {
                        this.fields = this.fields.map((e, i) => {
                            if (i === index) {
                                return this.fields[index + 1];
                            } else if (i === index + 1) {
                                return this.fields[index];
                            } else {
                                return e;
                            }
                        })
                    }
                },
                remove(index) {
                    this.fields.splice(index, 1);
                },
                camelCase(str) {
                    str = replaceAccents(str);
                    str = removeNonWord(str)
                        .replace(/\-/g, " ") //convert all hyphens to spaces
                        .replace(/\s[a-z]/g, upperCase) //convert first char of each word to UPPERCASE
                        .replace(/\s+/g, "") //remove spaces
                        .replace(/^[A-Z]/g, lowerCase); //convert first char to lowercase
                    return str;
                    function upperCase(str) {
                        return str.toUpperCase();
                    }
                    function lowerCase(str) {
                        return str.toLowerCase();
                    }
                    function removeNonWord(str) {
                        return str.replace(/[^0-9a-zA-Z\xC0-\xFF \-]/g, "");
                    }
                    function replaceAccents(str) {
                        // verifies if the String has accents and replace them
                        if (str.search(/[\xC0-\xFF]/g) > -1) {
                            str = str
                                .replace(/[\xC0-\xC5]/g, "A")
                                .replace(/[\xC6]/g, "AE")
                                .replace(/[\xC7]/g, "C")
                                .replace(/[\xC8-\xCB]/g, "E")
                                .replace(/[\xCC-\xCF]/g, "I")
                                .replace(/[\xD0]/g, "D")
                                .replace(/[\xD1]/g, "N")
                                .replace(/[\xD2-\xD6\xD8]/g, "O")
                                .replace(/[\xD9-\xDC]/g, "U")
                                .replace(/[\xDD]/g, "Y")
                                .replace(/[\xDE]/g, "P")
                                .replace(/[\xE0-\xE5]/g, "a")
                                .replace(/[\xE6]/g, "ae")
                                .replace(/[\xE7]/g, "c")
                                .replace(/[\xE8-\xEB]/g, "e")
                                .replace(/[\xEC-\xEF]/g, "i")
                                .replace(/[\xF1]/g, "n")
                                .replace(/[\xF2-\xF6\xF8]/g, "o")
                                .replace(/[\xF9-\xFC]/g, "u")
                                .replace(/[\xFE]/g, "p")
                                .replace(/[\xFD\xFF]/g, "y");
                        }
                        return str;
                    }
                }
            }
        });
    </script>
{% endblock %}