{% extends 'module.twig.html' %}

{% block title_page %}{{ _('modules')}}{% endblock %}
{% set this_page = _('moduleadmin_new') %}

{% block module %}

    {# TODO champ text rajouter variable is url UNE FOIS PAR MODULE #}
    {# TODO params global du module #}

    {% verbatim %}
        <div id="app">

            <div class="card mb-3" v-for="(field, index) in fields" style="margin-bottom: 30px">

                <div class="card-header">
                    <h5 class="float-left">Champ #{{ field.position }}</h5>
                    <div class="float-right">
                        <button class="btn btn-secondary" v-if="index !== 0" v-on:click="up( index )"><i class="fas fa-chevron-up"></i></button>
                        <button class="btn btn-secondary" v-if="index !== fields.length - 1" v-on:click="down( index )"><i class="fas fa-chevron-down"></i></button>
                    </div>
                </div>

                <div class="card-body">

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Nom du champ</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" v-model="newField.name">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Champ obligatoire</label>
                        <div class="col-sm-10">
                            <input type="checkbox" v-model="newField.empty">
                        </div>
                    </div>

                    <div class="form-group row" v-if="newField.empty">
                        <label class="col-sm-2 col-form-label">Message si vide</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" v-model="newField.emptyMessage">
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Type de champ</label>
                        <div class="col-sm-10">
                            <select name="type" v-model="newField.type" class="form-control">
                                <option v-for="fieldType in fieldTypes" :value="fieldType.value">{{ fieldType.text }}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-group row" v-if="newField.type === 'textarea'">
                    <label class="col-sm-4 col-form-label">Activer l'éditeur HTML</label>
                    <div class="col-sm-8">
                        <input type="checkbox" class="form-check-input" value="1" v-model="field.editor">
                    </div>
                </div>
            </div>

            <button v-on:click="addField" class="btn btn-primary">Ajouter un champ</button>

            <div class="card" v-if="fields.length" style="margin-top: 30px">
                <div class="card-body">
                    <pre>
                        <div v-for="line in generatedLines">
                            {{ line }}
                        </div>
                    </pre>
                    <div v-for="field in fields">
                        {{ field }}
                    </div>
                </div>
            </div>
        </div>
    {% endverbatim %}

{% endblock %}

{% block javascripts_end %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/vue/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.20.0/axios.min.js"></script>
    <script>
        var app = new Vue({

            el: '#app',

            data: {

                fieldTypes: [
                  { value: 'input', text: 'Texte' },
                  { value: 'select', text: 'Select' },
                  { value: 'textarea', text: 'Textarea' },
                  { value: 'gallery', text: 'Galerie' },
                  { value: 'document', text: 'Documents' },
                  { value: 'video', text: 'Video' },
                  { value: 'link', text: 'Lien' },
                  { value: 'image', text: 'Image' },
                  { value: 'radio', text: 'Radio' },
                  { value: 'checkbox', text: 'Checkbox' },
                  { value: 'integer', text: 'Chiffre entier' },
                  { value: 'float', text: 'Chiffre avec décimale' },
                  { value: 'icon', text: 'Icone' },
                  { value: 'password', text: 'Mot de passe' },
                  { value: 'date', text: 'Date' },
                  { value: 'hour', text: 'Heure' }
                ],

                newField: {
                  name: '',
                  type: '',
                  empty: false,
                  emptyMessage: ''
                },

                fields: []
            },

            computed: {
              generatedLines() {

                let arr = [];

                let name = ''
                name = this.camelCase(this.newField.name);
                name = '$this->build(\'' + name + '\')';
                arr.push(name);

                if (this.newField.empty) {
                    let emptyMessage = '';
                    emptyMessage = this.newField.emptyMessage;
                    emptyMessage = '->notEmpty("' + emptyMessage + '")';
                    arr.push(emptyMessage);
                }

                let type = '';
                if (this.newField.type === 'input') {
                    type = '->isVarchar()';
                } else if (this.newField.type === 'select') {
                    type = '->isSelect()';
                } else if (this.newField.type === 'textarea') {
                    type = '->isText()';
                } else if (this.newField.type === 'gallery') {
                    type = '->isGallery()';
                } else if (this.newField.type === 'documents') {
                    type = '->isDocument()';
                }
                arr.push(type);

                return arr;
              }
            },

            methods: {

                camelCase: function(str) {
                    str = replaceAccents(str);
                    str = removeNonWord(str)
                        .replace(/\-/g, " ") //convert all hyphens to spaces
                        .replace(/\s[a-z]/g, upperCase) //convert first char of each word to UPPERCASE
                        .replace(/\s+/g, "") //remove spaces
                        .replace(/^[A-Z]/g, lowerCase); //convert first char to lowercase
                    return str;

                    function upperCase(str) {
                        return str.toUpperCase();
                    }

                    function lowerCase(str) {
                        return str.toLowerCase();
                    }

                    function removeNonWord(str) {
                        return str.replace(/[^0-9a-zA-Z\xC0-\xFF \-]/g, "");
                    }

                    function replaceAccents(str) {
                        // verifies if the String has accents and replace them
                        if (str.search(/[\xC0-\xFF]/g) > -1) {
                            str = str
                            .replace(/[\xC0-\xC5]/g, "A")
                            .replace(/[\xC6]/g, "AE")
                            .replace(/[\xC7]/g, "C")
                            .replace(/[\xC8-\xCB]/g, "E")
                            .replace(/[\xCC-\xCF]/g, "I")
                            .replace(/[\xD0]/g, "D")
                            .replace(/[\xD1]/g, "N")
                            .replace(/[\xD2-\xD6\xD8]/g, "O")
                            .replace(/[\xD9-\xDC]/g, "U")
                            .replace(/[\xDD]/g, "Y")
                            .replace(/[\xDE]/g, "P")
                            .replace(/[\xE0-\xE5]/g, "a")
                            .replace(/[\xE6]/g, "ae")
                            .replace(/[\xE7]/g, "c")
                            .replace(/[\xE8-\xEB]/g, "e")
                            .replace(/[\xEC-\xEF]/g, "i")
                            .replace(/[\xF1]/g, "n")
                            .replace(/[\xF2-\xF6\xF8]/g, "o")
                            .replace(/[\xF9-\xFC]/g, "u")
                            .replace(/[\xFE]/g, "p")
                            .replace(/[\xFD\xFF]/g, "y");
                        }
                        return str;
                    }
                },

                addField: function () {
                    const index = this.fields.length + 1
                    this.fields.push({
                        name: 'champ' + index,
                        position: index
                    });
                },

                up: function (index) {
                    if (index !== 0) {
                        this.fields = this.fields.map((e, i) => { // iterate array and change places
                            if (i === index - 1) {
                                return this.fields[index];
                            } else if (i === index) {
                                return this.fields[index - 1];
                            } else {
                                return e;
                            }
                        })
                    }
                },

                down: function (index) {
                    if (index !== this.fields.length-1) { // if its the last in the array
                        this.fields = this.fields.map((e, i) => { // iterate array and change places
                            if (i === index) {
                                return this.fields[index + 1];
                            } else if (i === index + 1) {
                                return this.fields[index];
                            } else {
                                return e;
                            }
                        })
                    }
                }
            }
        })
    </script>
{% endblock %}