{% extends 'module.twig.html' %}

{% block title_page %}{{ _('modules')}}{% endblock %}
{% set this_page = _('moduleadmin_new') %}

{% block module %}

    {{ dump(depedency) }}
    {{ dump(module) }}

    {# TODO params global du module #}
    {# TODO affichage des modules créer #}

    <div id="app">

        <h4 style="margin-bottom: 20px">Paramètres du module</h4>

        <div class="card card-body" style="margin-bottom: 30px">

            {# TODO - module est dépendance #}
            {# TODO - module a des dépendance #}

            <div class="form-group row">
                <label class="col-sm-3">Édition</label>
                <div class="col-sm-9">
                    <div class="row">
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.delete">
                                delete
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.edit">
                                edit
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.add">
                                add
                            </label>
                        </div>
                        <div class="col-sm-3">
                            <label>
                                <input type="checkbox" v-model="globalParams.edition.valid">
                                valid
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Ordonner les éléments</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.order">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Nombre maximum d'éléments</label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" v-model="globalParams.limit">
                </div>
            </div>

            <div class="form-group row" v-if="!globalParams.hasDepedency">
                <label class="col-sm-3">Ce module est une dépendance</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.isDepedency">
                </div>
            </div>

            <div class="form-group row" v-if="!globalParams.isDepedency">
                <label class="col-sm-3">Ce module a des dépendances</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="globalParams.hasDepedency">
                </div>
            </div>

            <div class="form-group row" v-if="globalParams.hasDepedency">
                <label class="col-sm-3">Choisir les dépendances</label>
                <div class="col-sm-9">
                    <select multiple v-model="globalParams.depedencies">
                        <option value="moduleA">module A</option>
                        <option value="moduleB">module B</option>
                        <option value="moduleC">module C</option>
                    </select>
                </div>
            </div>
        </div>

        <h4 style="margin-bottom: 20px">Nouveau champ</h4>

        <div class="card card-body" style="margin-bottom: 30px">

            <div class="form-group row">
                <label class="col-sm-3">Nom du champ</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" v-model="newField.name">
                </div>
            </div>

            <div class="form-group row" v-if="!hasUrl">
                <label class="col-sm-3">Créer l'url à partir du nom</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="newField.isUrl">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Champ obligatoire</label>
                <div class="col-sm-9">
                    <input type="checkbox" v-model="newField.empty">
                </div>
            </div>

            <div class="form-group row" v-if="newField.empty">
                <label class="col-sm-3">Message si vide</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" v-model="newField.emptyMessage">
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3">Type de champ</label>
                <div class="col-sm-9">
                    <select name="type" v-model="newField.type" class="form-control">
                        <option v-for="fieldType in fieldTypes" :value="fieldType.value"><-- fieldType.text --></option>
                    </select>
                </div>
            </div>

            {#
                TODO type : select
                - manuel key value
                - auto fetch modules
            #}

            {#
                TODO type : gallery
                - idem image
            #}

            {#
                TODO type : document
            #}

            {#
                TODO type : video
            #}

            {#
                TODO type : link
            #}

            {#
                TODO type : image
                - thumb, cover, width, height
            #}

            {#
                TODO type : boolean
            #}

            {#
                TODO type : radio
                - manuel key value
                - auto fetch modules
            #}

            {#
                TODO type : checkbox
                - manuel key value
                - auto fetch modules
            #}

            {#
                TODO type : integer
                - step
            #}

            {#
                TODO type : float (décimal)
                - step
            #}

            {#
                TODO type : icon
            #}

            {#
                TODO type : password
            #}

            {#
                TODO type : date
                - avec ou sans heure
                - key value (string)
            #}

            {#
                TODO type : hour
            #}

            <div class="form-group row" v-if="newField.type === 'textarea'">
                <label class="col-sm-3">Activer l'éditeur HTML</label>
                <div class="col-sm-9">
                    <input type="checkbox" class="form-check-input" v-model="newField.textareaHtml">
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12 text-right">
                    <button v-on:click="addField" class="btn btn-primary" :disabled="!formValidation">Ajouter le champ</button>
                </div>
            </div>
        </div>

        <div v-if="fields.length" v-for="(field, index) in fields" class="card card-body" style="margin-bottom: 15px">
            <div class="float-right">
                <button class="btn btn-secondary" v-if="index !== 0" v-on:click="moveUp( index )">moveUp</button>
                <button class="btn btn-secondary" v-if="index !== fields.length - 1" v-on:click="moveDown( index )">moveDown</button>
            </div>
            <-- field -->
        </div>
    </div>
{% endblock %}

{% block javascripts_end %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/vue/dist/vue.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.20.0/axios.min.js"></script>
    <script>
        var app = new Vue({

            el: '#app',
            delimiters: ["<--","-->"],

            data: {

                fieldTypes: [
                    { value: 'input', text: 'Texte' },
                    { value: 'select', text: 'Select' },
                    { value: 'textarea', text: 'Textarea' },
                    { value: 'gallery', text: 'Galerie' },
                    { value: 'document', text: 'Documents' },
                    { value: 'video', text: 'Video' },
                    { value: 'link', text: 'Lien' },
                    { value: 'image', text: 'Image' },
                    { value: 'radio', text: 'Radio' },
                    { value: 'checkbox', text: 'Checkbox' },
                    { value: 'integer', text: 'Chiffre entier' },
                    { value: 'float', text: 'Chiffre avec décimale' },
                    { value: 'icon', text: 'Icone' },
                    { value: 'password', text: 'Mot de passe' },
                    { value: 'date', text: 'Date' },
                    { value: 'hour', text: 'Heure' }
                ],

                newField: {
                    name: '',
                    isUrl: false,
                    empty: false,
                    emptyMessage: '',
                    type: '',
                    textareaHtml: false
                },

                globalParams: {
                    edition: {
                        delete: true,
                        edit: true,
                        add: true,
                        valid: true
                    },
                    order: false,
                    limit: false,
                    isDepedency: false,
                    hasDepedency: false,
                    depedencies: []
                },

                fields: []
            },

            computed: {
                formValidation() {
                    if (this.newField.empty) {
                        return !!(
                            this.newField.name.length &&
                            this.newField.type.length > 0 &&
                            this.newField.emptyMessage.length > 0
                        );
                    } else {
                        return !!(
                            this.newField.name.length &&
                            this.newField.type.length > 0
                        );
                    }
                },
                hasUrl() {
                    const result = this.fields.filter(field => field.isUrl);
                    return result.length;
                }
            },

            methods: {

                addField: function () {
                    const index = this.fields.length + 1
                    this.fields.push({
                        title: 'champ' + index,
                        position: index,
                        name: this.camelCase(this.newField.name),
                        isUrl: this.newField.isUrl,
                        empty: this.newField.empty,
                        emptyMessage: this.newField.emptyMessage,
                        type: this.newField.type,
                        textareaHtml: this.newField.textareaHtml,
                    });
                    this.newField.name = '';
                    this.newField.type = '';
                    this.newField.empty = false;
                    this.newField.emptyMessage = '';
                },

                moveUp: function (index) {
                    if (index !== 0) {
                        this.fields = this.fields.map((e, i) => { // iterate array and change places
                            if (i === index - 1) {
                                return this.fields[index];
                            } else if (i === index) {
                                return this.fields[index - 1];
                            } else {
                                return e;
                            }
                        })
                    }
                },

                moveDown: function (index) {
                    if (index !== this.fields.length-1) { // if its the last in the array
                        this.fields = this.fields.map((e, i) => { // iterate array and change places
                            if (i === index) {
                                return this.fields[index + 1];
                            } else if (i === index + 1) {
                                return this.fields[index];
                            } else {
                                return e;
                            }
                        })
                    }
                },

                camelCase: function(str) {
                    str = replaceAccents(str);
                    str = removeNonWord(str)
                        .replace(/\-/g, " ") //convert all hyphens to spaces
                        .replace(/\s[a-z]/g, upperCase) //convert first char of each word to UPPERCASE
                        .replace(/\s+/g, "") //remove spaces
                        .replace(/^[A-Z]/g, lowerCase); //convert first char to lowercase
                    return str;

                    function upperCase(str) {
                        return str.toUpperCase();
                    }

                    function lowerCase(str) {
                        return str.toLowerCase();
                    }

                    function removeNonWord(str) {
                        return str.replace(/[^0-9a-zA-Z\xC0-\xFF \-]/g, "");
                    }

                    function replaceAccents(str) {
                        // verifies if the String has accents and replace them
                        if (str.search(/[\xC0-\xFF]/g) > -1) {
                            str = str
                                .replace(/[\xC0-\xC5]/g, "A")
                                .replace(/[\xC6]/g, "AE")
                                .replace(/[\xC7]/g, "C")
                                .replace(/[\xC8-\xCB]/g, "E")
                                .replace(/[\xCC-\xCF]/g, "I")
                                .replace(/[\xD0]/g, "D")
                                .replace(/[\xD1]/g, "N")
                                .replace(/[\xD2-\xD6\xD8]/g, "O")
                                .replace(/[\xD9-\xDC]/g, "U")
                                .replace(/[\xDD]/g, "Y")
                                .replace(/[\xDE]/g, "P")
                                .replace(/[\xE0-\xE5]/g, "a")
                                .replace(/[\xE6]/g, "ae")
                                .replace(/[\xE7]/g, "c")
                                .replace(/[\xE8-\xEB]/g, "e")
                                .replace(/[\xEC-\xEF]/g, "i")
                                .replace(/[\xF1]/g, "n")
                                .replace(/[\xF2-\xF6\xF8]/g, "o")
                                .replace(/[\xF9-\xFC]/g, "u")
                                .replace(/[\xFE]/g, "p")
                                .replace(/[\xFD\xFF]/g, "y");
                        }
                        return str;
                    }
                }
            }
        })
    </script>
{% endblock %}