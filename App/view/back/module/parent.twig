{% extends 'module.twig.html' %}

{% set this_page = 'Index' %}

{% block icon_page %}{{ mod.icon }}{% endblock %}

{% block module %}
    {% include 'module/header.twig' with {menu: false} %}
    {{ parent }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('canvas/css/src/easydoor/table.css') }}" />
    {% if hasValidation and right.validation == true %}<link rel="stylesheet" href="{{ asset('canvas/css/src/components/bs-switches.css') }}" type="text/css" />{% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('canvas/js/easydoor/table.js') }}"></script>
    {% if hasOrder and right.edit == true %}<script src="{{ asset('libs/jquery.tablednd.js') }}"></script>{% endif %}
    {% if hasValidation and right.validation == true %}<script src="{{ asset('canvas/js/components/bs-switches.js') }}" data-turbolinks-eval="false"></script>{% endif %}
    <script>
        $(function(){
            let maxHeight = 0;
            $('.feature-box').each(function() {
                if ( $(this).height() > maxHeight ) {
                    maxHeight = $(this).height();
                }
            });

            $('.feature-box').each(function() {
                $(this).css('height' , maxHeight);
            });
        });
    </script>
{% endblock %}