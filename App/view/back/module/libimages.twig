{% extends 'right-panel.twig' %}

{% block title_page %}<h3>{{ _('picture_biblio')}}</h3>{% endblock %}
{% block module %}

    <div class="tabs side-tabs nobottommargin clearfix" id="lib-images">
        <ul class="tab-nav tab-nav2 clearfix">
            {% for gallery in galleries %}
                <li><a href="#gallery-{{ gallery.id }}">{{ gallery.name }}</a></li>
            {% endfor %}
        </ul>
        <div class="tab-container">
            {% for gallery in galleries %}
                <div class="tab-content clearfix" id="gallery-{{ gallery.id }}" data-id="{{ gallery.id }}" data-loaded="{{ loop.first ? 1 : 0 }}" data-url="{{ route( mod.name , 'libimagesgallery' ) }}?gallery_id={{ gallery.id }}">

                    <div class="bottommargin-sm gallery-search">
                        <input type="text" class="form-control" placeholder="Rechercher..." />
                        <i class="icon-line-cross gallery-search-reset"></i>
                    </div>

                    {% if gallery.comment | length > 0 %}
                        <div style="margin-bottom: 10px;">
                            <em>{{ gallery.comment }}</em>
                        </div>
                    {% endif %}

                    <div class="gallery-content">
                        {% if loop.first %}
                            {% for img in images %}
                                <a href="javascript:;" class="select-picture" data-id="{{ img.media_id }}">
                                    <img src="{{ img.media_mini_name }}" data-full="{{ img.media_mini_name | split("/t") | first }}/{{ img.media_name }}"  class="" />
                                </a>
                            {% endfor %}
                        {% endif %}
                    </div>

                </div>
            {% endfor %}
        </div>
    </div>

    <div id="lib-images-zoom"></div>

    <style>
        .right-panel .side-tabs ul.tab-nav {
            padding: 10px 0;
            background-color: white;
            padding-bottom: 55px;
        }

        .right-panel .tab-container {
            padding: 10px 0 0 15px;
        }
        .gallery-search {
            position: relative;
        }
        .gallery-search input {
            padding-right: 32px;
        }
        .gallery-search-reset {
            position: absolute;
            top: 7px;
            right: 10px;
            cursor: pointer;
        }
        .select-picture img {
            border: 1px #d6d6d6 solid;
            margin: 0 3px 7px 0;
        }
        #lib-images-zoom {
            position: relative;
            border: 1px #d6d6d6 solid;
            text-align: center;
            height:400px;
        }
        #lib-images-zoom img {
            position: absolute;
            top: 50%;
            left: 50%;
            width: auto;
            height: auto;
            max-width: 100%;
            max-height: 100%;
            transform: translate( -50%, -50% );
        }
    </style>

    <script>
        var initSelectPicture = function (base) {
            $(base).find('.select-picture').click(function (e) {
                e.preventDefault();
                e.stopPropagation();

                $('#id_{{ name }}').val($(this).data('id'));
                $('#source_{{ field_name }}').attr('src', $(this).find('img').attr('src'));

                rightPanel.close();

                return false;
            });

            $(base).find("img").on("mouseenter", function() {
                $("#lib-images-zoom").html( '<div class="text-center"><i class="fa fa-cog fa-spin fa-3x fa-fw"></i></div>' );
                var img = new Image();
                img.src = $(this).attr("data-full");
                img.onload = function() {
                    $("#lib-images-zoom").html("").append( img );
                };
            }).on("mouseout", function() {
                $("#lib-images-zoom").html("");
            });
        };

        var initLibSearch = function (base) {
            $(base).find(".gallery-search input").on("input" , function () {
                var key = $(this).val().trim();
                $(this).parents(".tab-content").find(".select-picture").each(function() {
                    let split = $(this).find("img").data("full").split("/");
                    let name = split[ split.length - 1 ];
                    $(this)[ name.indexOf(key) > -1 ? "show" : "hide" ]();
                });
            });

            $(base).find(".gallery-search-reset").on("click", function() {
                $(this).prev().val("");
                $(this).parents(".tab-content").find(".select-picture").show();
            });
        };

        $(function () {
            initSelectPicture( "#lib-images" );
            initLibSearch( "#lib-images" );

            $tabs = $('#lib-images .tab-nav');
            $('#lib-images-zoom')
                .css( 'position', 'absolute' )
                .css( 'top' , $tabs.offset().top - $tabs.outerHeight() + 100)
                .css( 'left' , 0 )
                .css( 'width' , $tabs.width() )
                .css( 'height' , $tabs.width() );

            $("#lib-images").tabs({
                active: 0,
                activate: function (event, ui) {
                    var $panel   = $(ui.newPanel).eq(0);
                    var $content = $panel.find(".gallery-content");
                    if ($panel.attr("data-loaded") === "0") {

                        $content.html( '<div class="text-center"><i class="fa fa-cog fa-spin fa-3x fa-fw"></i></div>' );

                        $.ajax({
                            url: $panel.attr('data-url'),
                            method: "GET",
                            success: function (response) {
                                $content.html(response);
                                $panel.attr("data-loaded", 1);

                                initSelectPicture( $panel );
                            }
                        });

                    }
                }
            });
        });
    </script>
{% endblock %}