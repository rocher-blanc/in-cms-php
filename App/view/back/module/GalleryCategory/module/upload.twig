{% extends 'module.twig.html' %}

{% set this_page =  _('gestion_bibliotheque') %}

{% block module %}
    {% include 'module/header.twig' %}
    <form action="{{ route( mod.name , 'draw' , uri_id_parent , id ) }}" id="form-upload-gallery" class="uploader">
        <input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}" />
        <div class="dz-message" data-uploadmsg="{{ lib_upload_doing }}">
            <i class="icon-cloud-download"></i><br />
            <span>{{ lib_upload_msg }}</span>
        </div>
    </form>

    <div class="tab-container">
        <div class="tab-content clearfix" id="gallery-{{ id }}">
            {% for img in images %}
                <div class="mini lib-picture">
                    <img src="{{ img.media_mini_name }}" class="" />
                    <a href="{{ route( mod.name , 'deletemedia' , '' , img.media_id , csrf_token ) }}" class="overlay-picture deletelibimage"><i class="icon-trash"></i></a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('canvas/css/src/dropzone.min.css') }}" type="text/css" />
    <link rel="stylesheet" href="{{ asset('canvas/css/src/easydoor/libimage.css') }}" type="text/css" />
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('canvas/js/dropzone.min.js') }}"></script>
    <script src="{{ asset('canvas/js/easydoor/libimage.js') }}"></script>
{% endblock %}