{% extends 'module.twig.html' %}

{% set this_page = 'Gestion' %}

{% block module %}
    {% include 'module/header.twig' %}
    {% if select|length > 1 %}
    <div class="duplicate">
        <div class="col_one_fourth">
            <select id="duplicate-model" name="model" class="form-control select2">
                <option value="0" disabled selected>Créer un email à partir d'un gabarit existant</option>
                {% for key, name in select %}
                    {% if id != key %}<option value="{{ key }}">{{ name }}</option>{% endif %}
                {% endfor %}
            </select>
        </div>
        <div class="col_one_fourth">
            <a href="javascript:;" id="loadDupication" class="ed-button button button-rounded button-reveal button-small button-3d notopmargin"><i class="icon-save"></i><span>Dupliquer</span></a>
        </div>
    </div>
    {% endif %}
    <div id="topolcontent"></div>
{% endblock %}

{% block stylesheets %}
    <style>
        #topolcontent { height: 1500px; }
        #leftPane { background-color: pink; }
    </style>
    <link rel="stylesheet" href="{{ asset('canvas/css/src/dropzone.min.css') }}" type="text/css" />
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('canvas/js/easydoor/topol.js') }}"></script>
    <script src="{{ asset('canvas/js/dropzone.min.js') }}"></script>
    <script>
        $(function() {
            drawTopol({
                id: "#topolcontent",
                duplicateId: "#loadDupication",
                duplicateSelect: "#duplicate-model",
                apiKey: "{{ apiKey }}",
                userId: "{{ userId }}",
                idTopol: {{ idtopol }},
                urlDuplicate: '{{ route( mod.name , 'duplicate' , uri_id_parent , id ) }}',
                urlSave: '{{ route( mod.name , 'saveMail' , uri_id_parent , id ) }}',
                urlRedirect: '{{ route( mod.name , 'index' , uri_id_parent ) }}',
                urlSend: '{{ route( mod.name , 'sendMail' , uri_id_parent , id ) }}',
                urlFileManager: '{{ route( mod.name , 'topolFileManager' , uri_id_parent ) }}',
                urlUpload: '{{ route( mod.name , 'topolFileUpload' , uri_id_parent ) }}'
            });
        });
    </script>
{% endblock %}