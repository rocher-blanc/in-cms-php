{% extends 'right-panel.twig' %}

{% block title_page %}<h3>{{ _('select_listing_modal_title')}}</h3>{% endblock %}
{% block module %}


    <div class="table-responsive">
        <form action="{{ route( mod.name , 'selectListingSave' ) }}" method="POST" data-select-listing-form style="margin-bottom:0;">
            <input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}" />
            <input type="hidden" name="key" value="{{ key }}" />

            <table class="table table-striped table-hover" data-select-listing-table style="margin-bottom:0;">
                <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>
                        <span>Intitulé</span><br>
                    </th>
                    <th class="text-right" style="width: 40px;">
                    </th>
                </tr>
                </thead>
                <tbody>
                {% for itemId, item in elements %}
                    <tr class="tr1" data-parent-id="none">
                        <td class="tr1" data-parent-id="none">
                            <a href="javascript:;" class="color-theme orderTable"><i class="icon-move" style="margin:0"></i></a>
                        </td>
                        <td style="vertical-align: middle;">
                            {% for langId, langValue in item %}
                                <div class="input-group input-group-icon" style="margin-bottom: 5px;">
                                <span class="input-group-addon">
                                    <span class="icon">
                                        <i class="flag-icon flag-icon-{{ flags[langId] }}" style="margin:0;"></i>
                                    </span>
                                </span>
                                    <input type="text" value="{{ langValue }}" class="form-control" name="item[{{ itemId }}][{{ langId }}]" maxlength="255" />
                                </div>
                            {% endfor %}
                        </td>
                        <td class="text-right actionLink" style="vertical-align: middle;">
                            <a href="#" data-select-listing-remove-btn><i class="icon-trash2"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                <tr class="tr1" style="display: none;" data-select-listing-row-empty>
                    <td class="tr1" data-parent-id="none">
                        <a href="javascript:;" class="color-theme orderTable"><i class="icon-move" style="margin:0"></i></a>
                    </td>
                    <td style="vertical-align: middle;">
                        {% for langId,flag in flags %}
                            <div class="input-group input-group-icon" style="margin-bottom: 5px;">
                            <span class="input-group-addon">
                                <span class="icon">
                                    <i class="flag-icon flag-icon-{{ flag }}" style="margin:0;"></i>
                                </span>
                            </span>
                                <input type="text" value="" class="form-control" name="item[new][][{{ langId }}]" maxlength="255">
                            </div>
                        {% endfor %}
                    </td>
                    <td class="text-right actionLink" style="vertical-align: middle;">
                        <a href="#" data-select-listing-remove-btn><i class="icon-trash2"></i></a>
                    </td>
                </tr>
                </tbody>
            </table>

            <div style="padding-right:15px;">
                <a href="#" class="pull-right" data-select-listing-new-btn>
                    <i class="icon-line-plus" style="font-size:24px;"></i>
                </a>
                <button type="submit" name="submitbutton" value="redirect" class="ed-button button button-small button-rounded button-reveal">
                    <i class="icon-save"></i><span>Enregistrer</span>
                </button>
            </div>

        </form>
    </div>

    <script src="{{ asset('libs/jquery.tablednd.js') }}"></script>
    <script>

        initAddButton = function( base ) {
            $(base).find("[data-select-listing-new-btn]").on('click', function() {
                var trs = $('[data-select-listing-table]').find('tbody').find('tr');
                $copy = $('[data-select-listing-row-empty]').clone();
                $copy
                    .show()
                    .removeAttr('data-select-listing-row-empty')
                    .insertBefore( trs[ trs.length - 1 ] );

                initRemoveButton($copy);
                initMovable( base )

                return false;
            });
        }

        initRemoveButton = function( base ) {
            $(base).find("[data-select-listing-remove-btn]").on('click', function() {
                $(this).parents('tr').remove();
                return false;
            });
        }

        initMovable = function( base ) {
            $(base).find("[data-select-listing-table]").tableDnD({
                onDragStart: function(table, row) {
                    var parent = $(row).parent().parent().data('parent');
                    $("#" + $(row).data('tr')).addClass('myDragClass');
                    $('.table-parent').find('tr').each(function () {
                        if ($(this).data('parent') != parent) {
                            $(this).hide();
                        }
                    });
                },
                dragHandle: '.orderTable',
                onDragClass: 'myDragClass',
                // onDrop: function (table, row) {}
            });
        }

        initSave = function( base ) {
            $(base).find("[data-select-listing-form]").on('submit', function(e) {
                e.preventDefault();
                e.stopPropagation();

                $.ajax({
                    url   : $(this).attr('action'),
                    method: $(this).attr('method'),
                    data  : $("[data-select-listing-form]").serialize()
                });

                return false;
            });
        }

        $(function () {
            var base = '.right-panel-content';
            initAddButton( base );
            initRemoveButton( base );
            initMovable( base );
            initSave( base );
        });
    </script>
{% endblock %}