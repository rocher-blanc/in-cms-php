                        </thead>
                        <tbody>
                        {% for itemId, item in elements %}
                            <tr class="tr1" data-parent-id="none">
                                <td style="vertical-align: middle;">
                                    {% for langId, langValue in item %}
                                        <div class="input-group input-group-icon" style="margin-bottom: 5px;">
                                            <span class="input-group-addon">
                                                <span class="icon">
                                                    <i class="flag-icon flag-icon-{{ flags[langId] }}" style="margin:0;"></i>
                                                </span>
                                            </span>
                                            <input type="text" value="{{ langValue }}" class="form-control" name="item[{{ itemId }}][{{ langId }}]" maxlength="255" />
                                        </div>
                                    {% endfor %}
                                </td>
                                <td class="text-right actionLink" style="vertical-align: middle;">
                                    <a href="#" data-select-listing-remove-btn><i class="icon-trash2"></i></a>
                                </td>
                            </tr>
                        {% endfor %}
                        <tr class="tr1" data-parent-id="none">
                            <td style="vertical-align: middle;"></td>
                            <td class="text-right actionLink" style="vertical-align: middle;">
                                <a href="#" data-select-listing-new-btn><i class="icon-line-plus"></i></a>
                            </td>
                        </tr>
                        <tr class="tr1" style="display: none;" data-select-listing-row-empty>
                            <td style="vertical-align: middle;">
                                {% for langId,flag in flags %}
                                    <div class="input-group input-group-icon" style="margin-bottom: 5px;">
                                        <span class="input-group-addon">
                                            <span class="icon">
                                                <i class="flag-icon flag-icon-{{ flag }}" style="margin:0;"></i>
                                            </span>
                                        </span>
                                        <input type="text" value="" class="form-control" name="item[new][][{{ langId }}]" maxlength="255">
                                    </div>
                                {% endfor %}
                            </td>
                            <td class="text-right actionLink" style="vertical-align: middle;">
                                <a href="#" data-select-listing-remove-btn><i class="icon-trash2"></i></a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    <script>

        initAddButton = function( base ) {
            $(base).find("[data-select-listing-new-btn]").on('click', function() {
                var trs = $('[data-select-listing-table]').find('tbody').find('tr');
                $copy = $('[data-select-listing-row-empty]').clone();
                $copy
                    .show()
                    .removeAttr('data-select-listing-row-empty')
                    .insertBefore( trs[ trs.length - 2 ] );

                initRemoveButton($copy);

                return false;
            });
        }

        initRemoveButton = function( base ) {
            $(base).find("[data-select-listing-remove-btn]").on('click', function() {
                $(this).parents('tr').remove();
                return false;
            });
        }

        $(function () {
            var base = '.right-panel-content';
            initAddButton( base );
            initRemoveButton( base );
        });
    </script>
{% endblock %}