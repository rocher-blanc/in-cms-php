{% macro field(c, counter, width) %}
    <div class="ed_field {{ c.class }}{{ counter == width ? ' col_last' : '' }}{% if c.error != '' %} error{% endif %}{% if c.show == false %} {% if c.visible == false %}hide{% else %}hidden{% endif %}{% endif %}" data-show="{% if c.visible == true %}hidden{% else %}hide{% endif %}" id="field-{{ c.name }}" data-field="{{ c.fieldname }}">
        <label>{{ c.title }}{% if c.required != '' %} <span class="icon-asterisk"></span>{% endif %}</label>
        {% if c.comment != '' %}<div class="comment">{{ c.comment }}</div>{% endif %}
        {{ c.Form_HTML }}
    </div>
{% endmacro field %}
{% import _self as form %}

<form method="post" id="form-element-module" action="{{ route }}" data-depedency="{{ depedency ? "true" : "false" }}" data-route-condition="{{ route( mod.name , 'show' , uri_id_parent , (id != NULL ? id : '0') , csrf_token ) }}" data-condition="{{ condition ? "true" : "false" }}" data-slug="{{ mod.name|lower }}" class="form-vertical nomargin" enctype="multipart/form-data" accept-charset="utf-8">
    <div class="{{ mod.name|lower }}-form-process form-process"><i class="fa fa-cog fa-spin fa-3x fa-fw"></i></div>
    <input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}"/>
    <input type="hidden" name="id_element" id="id_element" value="{{ id != NULL ? id : '-1' }}" />
    {% for c in field if c.type == 'hidden' %}
        {{ c.Form_HTML }}
    {% endfor %}

    {% for tab in tabs %}
        {% set counter = 0 %}
        <div class="tab-content clearfix" id="tabs-{{ tab.key }}" data-onglet="onglet-{{ tab.key }}"{% if tab.show == false %} style="display: none;"{% endif %}>
            {% set counter = 0 %}
            {% set width = 0 %}
            {% for c in field if c.tab == tab.key and c.type != 'hidden' and not c.group %}
                {% if width == 0 %}
                    {% set width = c.width %}
                {% endif %}

                {% if c.part == c.width and counter != 0 %}
                    <div class="clearfix"></div>
                    {% set width = c.width %}
                    {% set counter = 0 %}
                {% endif %}

                {% set counter = counter + c.part %}

                {{ form.field(c, counter, width) }}

                {% if width == counter %}
                    {% set width = 0 %}
                    {% set counter = 0 %}
                    <div class="clearfix"></div>
                {% endif %}
            {% endfor %}
            {% if tab.group|length > 0 %}
                {% for group in tab.group %}

                    <div class="clearfix"></div>
                    {% set width = 0 %}
                    {% set counter = 0 %}

                    {% for c in field if c.tab == tab.key and c.type != 'hidden' and c.group == group.key %}
                        {% if loop.first %}
                            <div class="fancy-title title-double-border title-center topmargin-sm" id="group_form_{{ group.key }}"{% if group.show == false %} style="display: none;"{% endif %}><h4><span>{{ group.name}}</span></h4></div>
                        {% endif %}

                        {% if width == 0 %}
                            {% set width = c.width %}
                        {% endif %}

                        {% set counter = counter + c.part %}

                        {{ form.field(c, counter, width) }}

                        {% if width == counter %}
                            {% set width = 0 %}
                            {% set counter = 0 %}
                            <div class="clearfix"></div>
                        {% endif %}
                    {% endfor %}

                {% endfor %}
            {% endif %}

            {% include 'form/generic/button.twig' %}
        </div>
    {% endfor %}
</form>