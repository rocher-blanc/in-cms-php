<form method="post" action="{{ route }}" data-depedency="{{ depedency ? "true" : "false" }}" data-slug="{{ mod.name|lower }}" class="form-vertical nomargin" enctype="multipart/form-data" accept-charset="utf-8">
    <div class="{{ mod.name|lower }}-form-process form-process"><i class="fa fa-cog fa-spin fa-3x fa-fw"></i></div>
    <input type="hidden" name="{{csrf_key}}" value="{{csrf_token}}"/>
    <input type="hidden" name="id_element" id="id_element" value="{{ id != NULL ? id : '-1' }}" />
    {% for c in field if c.type == 'hidden' %}
        {{ c.Form_HTML }}
    {% endfor %}

    {% for tab in tabs %}
        {% set counter = 0 %}
        <div class="tab-content clearfix" id="tabs-{{ tab.key }}" data-onglet="onglet-{{ tab.key }}">
            {% set counter = 0 %}
            {% set width = 0 %}
            {% for c in field if c.tab == tab.key and c.type != 'hidden' %}
                {% if width == 0 %}
                    {% set width = c.width %}
                {% endif %}

                {% set counter = counter + c.part %}

                <div class="ed_field {{ c.class }}{{ counter == width ? ' col_last' : '' }}{% if c.error != '' %} error{% endif %}" id="field-{{ c.name }}">
                    <label>{{ c.title }}{% if c.required != '' %} <span class="icon-asterisk"></span>{% endif %}</label>
                    {% if c.comment != '' %}<div class="comment">{{ c.comment }}</div>{% endif %}
                    {{ c.Form_HTML }}
                </div>
                {% if width == counter %}
                    {% set width = 0 %}
                    {% set counter = 0 %}
                    <div class="clearfix"></div>
                {% endif %}
            {% endfor %}

            <div class="ed_field col_full">
                <button class="ed-button button button-rounded button-reveal button-large button-3d"><i class="icon-save"></i><span>Enregistrer</span></button>
            </div>
            <div class="ed_field col_full">
                <p class="ed-note"><strong>Note :</strong> veuillez remplir les champs marqués d'un <span class="icon-asterisk"></span></p>
            </div>
        </div>
    {% endfor %}
</form>