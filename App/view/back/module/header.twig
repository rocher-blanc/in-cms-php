{% if parentLine.array|length > 0 %}
    {% set count = parentLine.array|length + 1 %}
    <ul class="process-steps process-{{ count }} clearfix" style="margin-bottom: 10px;">
        {% for parent in parentLine.array %}
            <li{{ parent.current == true ? ' class="active"' : '' }}>
                <a href="{{ route( mod.name , 'index' , parent.url ) }}" class="i-bordered i-circled divcenter {{ parent.icon }}"></a>
                <h5>{{ parent.human_name }}</h5>
            </li>
        {% endfor %}
        <li{{ parentLine.current == null ? ' class="active"' : '' }}>
            <a href="{{ route( mod.name , 'index' , uri_id_parent ) }}" class="i-bordered i-circled divcenter {{ mod.icon }}"></a>
            <h5>{{ mod.title }}</h5>
        </li>
    </ul>
{% endif %}

{% if menu != false and depedency == false %}
    <div class="ed-menu">
        <a href="{{ route( mod.name , 'index' , uri_id_parent ) }}" class="button button-mini"><i class="icon-th-list"></i>{{ _('button_manage')}}</a>
        {% if mod.canCreate == true %}<a href="{{ route( mod.name , 'add' , uri_id_parent ) }}" class="button button-mini"><i class="icon-plus"></i>{{ _('button_add')}}</a>{% endif %}
        {% if menu != false and mod.canImport == true %}<a href="{{ route( mod.name , 'import' , uri_id_parent ) }}" class="button button-mini"><i class="icon-cloud-upload"></i>{{ _('button_import')}}</a>{% endif %}
        {% if isIndex == true %}
            <a href="{{ route( mod.name , 'export' , uri_id_parent ) }}?elmt_per_page=all" class="button button-mini" data-export-btn><i class="icon-cloud-download"></i>{{ _('button_export')}}</a>
            <div class="btn-group">
                <button type="button" class="button button-mini dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="icon-magic"></i>{{ _('personnaliser')}}<i class="icon-caret-down"></i>
                </button>
                <div class="dropdown-menu" data-action="{{ route( mod.name , 'customization' , uri_id_parent ) }}" data-table="table-content-{{ mod.name }}">
                    {% for name, field in fields if field.table == true %}
                        <a class="dropdown-item{{ field.active ? ' active' : '' }}" href="javascript:;" data-name="{{ name }}">{{ field.title }}</a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
    <div class="divider divider-center ed-divider"><i class="{{ mod.icon }}"></i></div>
{% endif %}