{% if depedency == true %}
    {% set extend = 'modal.twig' %}
{% else %}
    {% set extend = 'module.twig.html' %}
{% endif %}

{% extends extend %}

{% block icon_page %}{{ mod.icon }}{% endblock %}
{% block title_page %}{{ mod.title }}{% endblock %}

{% if id != '' %}
    {% set this_page = 'Edition' %}
{% else %}
    {% set this_page = 'Ajout' %}
{% endif %}

{% block module %}
    {% include 'module/header.twig' %}
    <div class="ed_element tabs tabs-bordered tabs-tb clearfix" data-active="1">
        <ul class="tab-nav clearfix">
            {% for tab in tabs %}
                <li{{ loop.first ? ' class="ui-tabs-active"' : '' }}>
                    <a href="#tabs-{{ tab.key }}" id="onglet-{{ tab.key }}">
                        <i class="{{ tab.icon }}"></i> {{ tab.name }}
                    </a>
                </li>
            {% endfor %}

            {% if seo == true and id != '' %}
                <li>
                    <a href="#tabs-seo" id="onglet-seo">
                        <i class="icon-unlink"></i> Référencement
                    </a>
                </li>
            {% endif %}
            {% if depedencies|length > 0 and id != '' %}
                {% for dependency in depedencies %}
                    <li>
                        <a href="#tabs-{{ dependency.slug }}" id="onglet-{{ dependency.slug }}">
                            <i class="{{ dependency.icon }}"></i> {{ dependency.name }}
                        </a>
                    </li>
                {% endfor %}
            {% endif %}
            {% if id != '' %}
                <li>
                    <a href="#tabs-history" id="onglet-history">
                        <i class="icon-time"></i> Historique
                    </a>
                </li>
            {% endif %}
        </ul>
        <div class="tab-container" id="form-module">
            {{ form }}
            {% if id != '' %}
                <div class="tab-content clearfix" id="tabs-history" data-onglet="onglet-history">
                    {% include 'module/tab_history.twig' %}
                </div>
            {% endif %}
            {% if id != '' %}
                {% if depedencies|length > 0 %}
                    {% for dependency in depedencies %}
                        <div class="tab-content clearfix" id="tabs-{{ dependency.slug }}" data-onglet="onglet-{{ dependency.slug }}">
                            <a class="ed-button button button-rounded button-reveal button-large button-3d" data-lightbox="ajax" href="{{ dRoute(dependency.name , 'add' , ( id != NULL ? id : '-1' ) , mod.id ) }}"><i class="icon-plus"></i><span>Ajouter</span></a>
                        </div>
                    {% endfor %}
                {% endif %}
            {% endif %}
            {% if seo == true and id != '' %}
            <div class="tab-content clearfix" id="tabs-seo" data-onglet="onglet-seo">
                {% include 'module/tab_seo.twig' %}
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ cdn_css }}
    {{ css }}
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" /><!-- Pour date range + form-process -->
    <link rel="stylesheet" href="{{ asset('canvas/css/src/flag-icon/css/flag-icon.min.css') }}"/>
{% endblock %}

{% block javascripts %}
    {{ cdn_js }}
    {{ js }}
    <script src="{{ asset('canvas/js/easydoor/form.js') }}"></script>
{% endblock %}