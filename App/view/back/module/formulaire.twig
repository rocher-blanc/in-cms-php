{% if depedency == true %}
    {% set extend = 'modal.twig' %}
{% else %}
    {% set extend = 'module.twig.html' %}
{% endif %}

{% extends extend %}

{% block icon_page %}{{ mod.icon }}{% endblock %}
{% block title_page %}{{ mod.title }}{% endblock %}

{% if id != '' %}
    {% set this_page = 'Edition' %}
{% else %}
    {% set this_page = 'Ajout' %}
{% endif %}

{% block module %}
    {% include 'module/header.twig' %}
    {% if mod.canCreate == false and action == 'add' %}
        <div class="style-msg alertmsg">
            <div class="sb-msg"><i class="icon-warning-sign"></i><strong>Attention!</strong> Une limite d'élément a été fixé, il est impossible d'ajouter de nouveaux éléments.</div>
        </div>
    {% else %}
        <div class="ed_element formulaire tabs tabs-bordered tabs-tb clearfix" data-active="1">
            <ul class="tab-nav clearfix">
                {% set first = false %}
                {% for tab in tabs %}
                    {% if first == false and tab.show == true %}
                        {% set first = true %}
                        <li class="ui-tabs-active" id="tabs-link-{{ tab.key }}">
                    {% elseif tab.show == false %}
                        <li class="hide" id="tabs-link-{{ tab.key }}">
                    {% else %}
                        <li id="tabs-link-{{ tab.key }}">
                    {% endif %}
                        <a href="#tabs-{{ tab.key }}" id="onglet-{{ tab.key }}">
                            <i class="{{ tab.icon }}"></i> {{ tab.name }}
                        </a>
                    </li>
                {% endfor %}

                {% if seo == true and id != '' %}
                    <li>
                        <a href="#tabs-seo" id="onglet-seo">
                            <i class="icon-unlink"></i> Référencement
                        </a>
                    </li>
                {% endif %}
                {% if depedencies|length > 0 and id != '' %}
                    {% for dependency in depedencies %}
                        <li>
                            <a href="#tabs-{{ dependency.slug }}" id="onglet-{{ dependency.slug }}">
                                <i class="{{ dependency.icon }}"></i> {{ dependency.name }}
                            </a>
                        </li>
                    {% endfor %}
                {% endif %}
                {% if id != '' and depedency == false %}
                    <li>
                        <a href="#tabs-history" id="onglet-history">
                            <i class="icon-time"></i> Historique
                        </a>
                    </li>
                {% endif %}
            </ul>
            <div class="tab-container" id="form-module-{{ mod.name }}">
                {{ form }}
                {% if id != '' and depedency == false %}
                    <div class="tab-content clearfix" id="tabs-history" data-onglet="onglet-history">
                        {% include 'module/tab_history.twig' %}
                    </div>
                {% endif %}
                {% if id != '' %}
                    {% if depedencies|length > 0 %}
                        {% for dependency in depedencies %}
                            <div class="tab-content clearfix" id="tabs-{{ dependency.slug }}" data-onglet="onglet-{{ dependency.slug }}">
                                {% if dependency.max == 1 and dependency.delete == false %}
                                    <div class="depedencyForm" id="form-content-{{ dependency.class }}" data-form="{{ dRoute(dependency.class , 'form' , ( id != NULL ? id : '-1' ) , mod.id ) }}"></div>
                                {% else %}
                                    <div class="ed-menu bottommargin-sm">
                                        <a data-modal="true" href="{{ dRoute(dependency.class , 'add' , ( id != NULL ? id : '-1' ) , mod.id ) }}" class="button button-mini"><i class="icon-plus"></i>Ajouter</a>
                                        <div class="btn-group">
                                            <button type="button" class="button button-mini dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <i class="icon-magic"></i>Personnaliser<i class="icon-caret-down"></i>
                                            </button>
                                            <div class="dropdown-menu" data-action="{{ dRoute(dependency.class , 'customization' , ( id != NULL ? id : '-1' ) , mod.id ) }}" data-table="table-content-{{ dependency.class }}">
                                                {% for name, field in dependency.fields if field.table == true %}
                                                    <a class="dropdown-item{{ field.active ? ' active' : '' }}" href="javascript:;" data-name="{{ name }}">{{ field.title }}</a>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="depedencyContent table-responsive" id="table-content-{{ dependency.class }}" data-table="{{ dRoute(dependency.class , 'table' , ( id != NULL ? id : '-1' ) , mod.id ) }}"></div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %}
                {% endif %}
                {% if seo == true and id != '' %}
                <div class="tab-content clearfix" id="tabs-seo" data-onglet="onglet-seo">
                    {% include 'module/tab_seo.twig' %}
                </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ cdn_css }}
    {{ css }}
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" /><!-- Pour date range + form-process -->
    <link rel="stylesheet" href="{{ asset('canvas/css/src/flag-icon/css/flag-icon.min.css') }}"/>
    <!-- Select -->
    <link rel="stylesheet" href="{{ asset('canvas/css/src/components/bs-select.css') }}" />
    <!-- File upload -->
    <link rel="stylesheet" href="{{ asset('canvas/css/src/components/bs-filestyle.css') }}" />
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('libs/jquery-ui.min.js') }}"></script>
    {{ cdn_js }}
    {{ js }}
    <!-- Select -->
    <script src="{{ asset('canvas/js/components/bs-select.js') }}"></script>
    <!-- File upload -->
    <script src="{{ asset('canvas/js/components/bs-filestyle.js') }}"></script>
    <script src="{{ asset('canvas/js/easydoor/locales/fileinput/fr.js') }}"></script>
    {% if depedencies|length > 0 %}
        <script src="{{ asset('libs/jquery.tablednd.js') }}"></script>
        <script src="{{ asset('canvas/js/components/moment.js') }}"></script>
        <script src="{{ asset('canvas/js/components/daterangepicker.js') }}"></script>
        <script src="{{ asset('canvas/js/easydoor/table.js') }}"></script>
    {% endif %}
    <script src="{{ asset('canvas/js/easydoor/form.js') }}"></script>
{% endblock %}