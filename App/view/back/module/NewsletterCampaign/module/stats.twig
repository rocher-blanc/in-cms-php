{% extends 'module.twig.html' %}
{% set this_page =  _('gestion') %}
{% block module %}
    {% include 'module/header.twig' %}
    <h4 class="ed-h4"><i class="icon-eye-open"></i>{{ rst.subject }}</h4>
    <h4 class="ed-h4"><i class="icon-users"></i>{% for dest in rst.destinataires %}{% if not loop.first %}, {% endif %}{{ dest }}{% endfor %}</h4>
    {% if res.State != 11 %}
        {% if res.Sent > 0 %}
            {% set pourcentRead = res.RecipientsRead/res.Sent*100 %}
        {% else %}
            {% set pourcentRead = 0 %}
        {% endif %}
        {% if res.Sent > 0 %}
            {% set pourcentClick = res.RecipientsClic/res.Sent*100 %}
        {% else %}
            {% set pourcentClick = 0 %}
        {% endif %}
        <div class="dark bottommargin-lg">
            <div class="text-center">
                <div class="counter counter-large color"><span data-from="0" data-to="{{ res.Sent }}" data-refresh-interval="5" data-speed="500">0</span> / {{ res.ToSend }}</div>
                {% if res.Sent > 1 %}
                    <h3>{{ _('email-sent-plur')}}</h3>
                {% else %}
                    <h3>{{ _('email-sent-sing')}}</h3>
                {% endif %}
            </div>
        </div>
        <div class="fancy-title title-dotted-border title-center">
            <h3><span>{{ _('state')}}</span></h3>
        </div>
        <h4 class="text-center"><span style="color:{% if res.State == 10 %}#3c763d{% else %}#31708f{% endif %};">{{ res.StateStr }}</span></h4>
        <div class="fancy-title title-dotted-border title-center">
            <h3><span>{{ _('actions')}}</span></h3>
        </div>
        <div class="text-center" style="margin-bottom: 15px;">
            <a class="button button-3d button-small button-amber button-rounded" href="{{ route( mod.name , 'downloadStatistic' , uri_id_parent , id , csrf_token ) }}"><i class="icon-download"></i> {{ _('stat_globales')}} (.PDF)</a>
            <a class="button button-3d button-small button-black button-rounded" href="{{ route( mod.name , 'downloadStatisticDest' , uri_id_parent , id , csrf_token ) }}"><i class="icon-download"></i> {{ _('stat_receivers')}} (.XLS)</a>
            {% if pourcentRead < 100 %}<a class="button button-3d button-small button-rounded aAjax" href="{{ route( mod.name , 'resendNoReadView' , uri_id_parent , id , csrf_token ) }}" data-lightbox="ajax" style="background-color: #00afaf;"><i class="icon-eye-close"></i> {{ _('renvoyer_nonlu')}}</a>{% endif %}
            {% if pourcentClick < 100 %}<a class="button button-3d button-small button-rounded aAjax" href="{{ route( mod.name , 'resendNoClickView' , uri_id_parent , id , csrf_token ) }}" data-lightbox="ajax"><i class="icon-line2-cursor"></i> {{ _('renvoyer_nonclic')}}</a>{% endif %}
        </div>
        <div class="fancy-title title-dotted-border title-center">
            <h3><span>{{ _('stat')}}</span></h3>
        </div>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>{{ _('informations')}}</th>
                    <th class="center">{{ _('valeur')}}</th>
                    <th class="center">%</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>{{ _('email_delivered_rate')}}</td>
                    {% set ndelivres = res.Sent - res.HardBounces %}
                    {% if res.Sent > 0 %}
                        {% set pourcent = ndelivres/res.Sent*100 %}
                    {% else %}
                        {% set pourcent = 0 %}
                    {% endif %}
                    <td class="center">{{ ndelivres }}</td>
                    <td class="center">{{ pourcent|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('email_opened_rate')}}</td>
                    <td class="center">{{ res.RecipientsRead }}</td>
                    <td class="center">{{ pourcentRead|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('nbr_clic')}}</td>
                    {% set totalclics = 0 %}
                    {% for item in links %}
                        {% set totalclics = totalclics + item.clicCount %}
                    {% endfor %}
                    <td class="center">{{ totalclics }}</td>
                    <td class="center">-</td>
                </tr>
                <tr>
                    <td>{{ _('nbr_clic_rate')}}</td>
                    <td class="center">{{ res.RecipientsClic }}</td>
                    <td class="center">{{ pourcentClick|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('taux_reactivite')}}</td>
                    {% if res.RecipientsRead != 0 %}
                        {% set pourcent = res.RecipientsClic/res.RecipientsRead*100 %}
                    {% else %}
                        {% set pourcent = 0 %}
                    {% endif %}
                    <td class="center">-</td>
                    <td class="center">{{ pourcent|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('email_softbounce')}}</td>
                    {% if res.Sent > 0 %}
                        {% set pourcent = res.SoftBounces/res.Sent*100 %}
                    {% else %}
                        {% set pourcent = 0 %}
                    {% endif %}
                    <td class="center">{{ res.SoftBounces }}</td>
                    <td class="center">{{ pourcent|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('email_hardbounce')}}</td>
                    {% if res.Sent > 0 %}
                        {% set pourcent = res.HardBounces/res.Sent*100 %}
                    {% else %}
                        {% set pourcent = 0 %}
                    {% endif %}
                    <td class="center">{{ res.HardBounces }}</td>
                    <td class="center">{{ pourcent|number_format(2, ',') }} %</td>
                </tr>
                <tr>
                    <td>{{ _('unsubscribe_nbr')}}</td>
                    {% if res.Sent > 0 %}
                        {% set pourcent = res.Unsubscribe/res.Sent*100 %}
                    {% else %}
                        {% set pourcent = 0 %}
                    {% endif %}
                    <td class="center">{{ res.Unsubscribe }}</td>
                    <td class="center">{{ pourcent|number_format(2, ',') }} %</td>
                </tr>
                </tbody>
            </table>
        </div>
    {% endif %}
    <div class="fancy-title title-dotted-border title-center">
        <h3><span>{{ _('link_plur')}}</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ _('url')}}</th>
                <th class="center">{{ _('total_clic')}}</th>
                <th class="center">{{ _('net_clic')}}</th>
            </tr>
            </thead>
            <tbody>
            {% for item in links %}
                <tr>
                    <td>{{ item.link }}</td>
                    <td class="center">{{ item.clicCount }}</td>
                    <td class="center">{{ item.recipientsClic }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% set tabStatus = [] %}
    {% for item in dests %}
        {% set state = item.state %}
        {% set label = attribute(status, item.state) %}
        {% if label in tabStatus|keys %}
            {% set count = attribute(tabStatus, label) %}
            {% set count = count + 1 %}
            {% set tabStatus = tabStatus|merge({(label): count}) %}
        {% else %}
            {% set count = 1 %}
            {% set tabStatus = tabStatus|merge({(label): count}) %}
        {% endif %}
    {% endfor %}
    <div class="fancy-title title-dotted-border title-center">
        <h3><span>{{ _('statut_reception')}}</span></h3>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ _('status')}}</th>
                <th class="center">{{ _('nbr_email')}}</th>
            </tr>
            </thead>
            <tbody>
            {% for key,item in tabStatus %}
                <tr>
                    <td>{{ key }}</td>
                    <td class="center">{{ item }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="fancy-title title-dotted-border title-center">
        <h3><span>{{ _('liste_envoi')}}</span></h3>
    </div>
    <div class="table-responsive">
        <table id="ed-table-gestion" class="table table-striped table-hover table-condensed dataTableSimple">
            <thead class="thead-inverse">
            <tr>
                <th>{{ _('email')}}</th>
                <th>{{ _('status')}}</th>
                <th class="center">{{ _('opened')}} (UTC)</th>
                <th>{{ _('absence_msg')}}</th>
                <th class="center">{{ _('total_clic_nbr')}}</th>
                <th class="center">{{ _('nbr_clic_unique')}}</th>
            </tr>
            </thead>
            <tbody data-order="0" data-sens="asc">
            {% for item in dests %}
                <tr>
                    <td>{{ item.email }}</td>
                    <td>{{ attribute(status, item.state) }}</td>
                    {% if item.read == 1 %}
                        <td class="center"><span class="hidden">{{ item.readDateUTC }}</span>{{ item.readDateUTC|date("d/m/Y") }} {{ _('to')}} {{ item.readDateUTC|date("H:i") }}</td>
                    {% else %}
                        <td class="center"><i class="icon-line-circle-cross danger"></i></td>
                    {% endif %}
                    {% if item.vacation %}
                        <td>{{ item.vacation }}</td>
                    {% else %}
                        <td>-</td>
                    {% endif %}
                    <td class="center">{{ item.clicCount }}</td>
                    <td class="center">{{ item.linkClicCount }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}