{% extends 'module.twig.html' %}

{% set this_page = 'Index' %}

{% block module %}
    {% include 'module/header.twig' %}
    <input type="hidden" name="url_table" id="url_table" value="{{ route( mod.name , 'table' , uri_id_parent ) }}">
    <div class="table-responsive" id="table-content">
        {{ table }}
    </div>
{% endblock %}

{% block icon_page %}{{ mod.icon }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" /><!-- Pour date range + form-process -->
    <link rel="stylesheet" href="{{ asset('canvas/css/src/components/daterangepicker.css') }}" />
    <link rel="stylesheet" href="{{ asset('canvas/css/src/components/bs-boxes.css') }}" />
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('canvas/js/components/moment.js') }}"></script>
    <script src="{{ asset('canvas/js/components/daterangepicker.js') }}"></script>
    <script src="{{ asset('canvas/js/components/bs-boxes.js') }}"></script>
    <script src="{{ asset('canvas/js/easydoor/table.js') }}"></script>
    {% if hasOrder and right.edit == true %}<script src="{{ asset('libs/jquery.tablednd.js') }}"></script>{% endif %}
{% endblock %}