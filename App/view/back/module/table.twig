{% set enableSelect = hasValidation or mod.canDelete %}

{% if td|length > 0 or search == 1 %}
    <form action="{% if depedency %}{{ dRoute( mod.name , 'table' , dElement , dModule ) }}{% else %}{{ route( mod.name , 'table' , uri_id_parent ) }}{% endif %}" method="get" class="tableFormSearch" data-container="table-content-{{ mod.name }}">
        <div class="table-responsive">
            <table class="table table-striped table-hover{{ hasOrder ? ' table-dnd' : '' }}" id="table-{{ mod.name }}" data-name="{{ mod.name }}">
                <thead>
                <tr>
                    {% if enableSelect %}
                        <th style="width: 50px;"></th>
                    {% endif %}
                    {% if hasOrder and right.edit == true %}
                        <th style="width: 50px;"></th>
                    {% endif %}
                    {% for thvalue in th %}
                        <th>
                            <span>{{ thvalue.title }}</span><br/>
                            {% if thvalue.type != 'image' and thvalue.type != 'checkbox' and thvalue.search == true %}
                                <a data-filter data-by="desc" data-order="{{ thvalue.name }}" href="javascript:;" class="filter{% if order == thvalue.name and by == 'desc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="{{ _('order_desc')}}"><i class="icon-chevron-sign-down"></i></a>
                                <a data-filter data-by="asc" data-order="{{ thvalue.name }}" href="javascript:;" class="filter{% if order == thvalue.name and by == 'asc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="{{ _('order_asc')}}"><i class="icon-chevron-sign-up"></i></a>
                            {% else %}
                                <br/>
                            {% endif %}
                        </th>
                    {% endfor %}
                    {% if hasDefault %}
                        <th style="width: 100px;">
                            {{ _('default') }}<br />
                        </th>
                    {% endif %}
                    {% if hasValidation %}
                        <th style="width: 100px;">
                            {{ _('online') }}<br />
                            <a data-filter data-by="desc" data-order="{{ validationName }}" href="javascript:;" class="filter{% if order == validationName and by == 'desc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="{{ _('order_desc')}}"><i class="icon-chevron-sign-down"></i></a>
                            <a data-filter data-by="asc" data-order="{{ validationName }}" href="javascript:;" class="filter{% if order == validationName and by == 'asc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="{{ _('order_asc')}}"><i class="icon-chevron-sign-up"></i></a>
                        </th>
                    {% endif %}
                    <th class="text-right" style="width: 220px;">
                        {{ _('afficher')}}<select class="form-control form-control-sm inline" name="elmt_per_page" style="width: 75px; margin: 0 5px;">
                            <option value="10" {{ elmt_per_page == '10' ? ' selected' : '' }}>10</option>
                            <option value="25"{{ elmt_per_page == '25' ? ' selected' : '' }}>25</option>
                            <option value="50"{{ elmt_per_page == '50' ? ' selected' : '' }}>50</option>
                            <option value="100"{{ elmt_per_page == '100' ? ' selected' : '' }}>100</option>
                            <option value="all"{{ elmt_per_page == 'all' ? ' selected' : '' }}>{{ _('all')}}</option>
                        </select>{{ _('elements')}}
                    </th>
                </tr>
                <tr class="trSearch">
                    {% if enableSelect %}
                        <th style="width: 50px;"></th>
                    {% endif %}
                    {% if hasOrder and right.edit == true %}
                        <td style="width: 50px;"></td>
                    {% endif %}
                    {% for thvalue in th %}
                        <td>
                            {% if loop.first %}
                                <input type="hidden" value="{{ order }}" name="order" class="tableOrderSearch" />
                                <input type="hidden" value="{{ by }}" name="by" class="tableBySearch" />
                                <input type="hidden" value="{{ page }}" name="page" class="tablePage" />
                                <input type="hidden" value="1" name="search" />
                            {% endif %}

                            {% if thvalue.search == true %}
                                {% if thvalue.type == 'textarea' or thvalue.type == 'text' or thvalue.type == 'hidden' %}
                                    <input type="text" class="form-control form-control-sm" name="{{ thvalue.name }}" value="{{ thvalue.value }}" />
                                {% elseif thvalue.type == 'date' %}
                                    <input type="text" class="form-control form-control-sm daterange" name="{{ thvalue.name }}" value="{{ thvalue.value }}" />
                                {% elseif thvalue.type == 'number' %}
                                    <div class="input-group searchNumber">
                                        <input type="number" class="form-control form-control-sm" style="border-radius: 3px;" name="{{ thvalue.name }}_start" value="{{ thvalue.value_start }}" placeholder="{{ _('from')}}" />
                                    </div>
                                    <div class="input-group" style="margin-top: 2px;">
                                        <input type="number" class="form-control form-control-sm" style="border-radius: 3px;" name="{{ thvalue.name }}_end" value="{{ thvalue.value_end }}" placeholder="{{ _('to')}}" />
                                    </div>
                                {% elseif thvalue.type == 'select' %}
                                    <select name="{{ thvalue.name }}" class="form-control form-control-sm" data-plugin-selectTwo>
                                        <option value=""{{ thvalue.value == '' ? ' selected' : '' }}>----- {{ _('no_select')}} -----</option>
                                        {% for key,value in thvalue.options %}
                                            {% if value is iterable %}
                                            {% else %}
                                                <option value="{{ key }}"{{ key == thvalue.value and thvalue.value is not same as('') and thvalue.value is not same as(null) ? ' selected' : '' }}>{{ value }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                {% elseif thvalue.type == 'checkbox' %}
                                    <select name="{{ thvalue.name }}[]" class="form-control" data-plugin-selectPicker data-size="10" multiple title="Sélectionner les options" data-selected-text-format="count>2" data-live-search="true">
                                        {% for key,value in thvalue.options %}
                                            <option value="{{ key }}"{{ key in thvalue.value ? ' selected' }}>{{ value }}</option>
                                        {% endfor %}
                                    </select>
                                {% elseif thvalue.type == 'radio' and thvalue.boolean == true %}
                                    <select name="{{ thvalue.name }}" class="form-control form-control-sm" data-plugin-selectTwo>
                                        <option value=""{{ thvalue.value == '' ? ' selected' : '' }}>{{ _('all')}}</option>
                                        <option value="1"{{ thvalue.value == '1' ? ' selected' : '' }}>{{ _('oui')}}</option>
                                        <option value="-1"{{ thvalue.value == '-1' ? ' selected' : '' }}>{{ _('non')}}</option>
                                    </select>
                                {% endif %}
                            {% endif %}
                        </td>
                    {% endfor %}
                    {% if hasDefault %}
                        <td></td>
                    {% endif %}
                    {% if hasValidation %}
                        <td></td>
                    {% endif %}
                    <td class="text-right searchButton">
                        <button class="button button-rounded button-reveal button-small button-3d" type="submit"><i class="icon-search2"></i><span>{{ _('rechercher')}}</span></button>
                        {% if search == 1 %}<a class="button button-rounded button-reveal button-light button-white button-small button-3d initsearch" href="javascript:;"><i class="icon-repeat"></i><span>{{ _('reinitialiser')}}</span></a>{% endif %}
                    </td>
                </tr>
                </thead>
                <tbody>
                {% for content in td %}
                    <tr class="tr1" data-parent-id="none" id="{{ content.id }}">
                        {% if enableSelect %}
                            <td class="text-center">
                                {% if right.delete == true and mod.canDelete == true and content.delete == true %}
                                    <input type="checkbox" name="select[{{ content.id }}]" data-id="{{ content.id }}" data-module-table-action-many-checkbox />
                                {% endif %}
                            </td>
                        {% endif %}
                        {% if hasOrder and right.edit == true %}
                            <td>{% if order == 'order' %}<a href="javascript:;" class="color-theme orderTable" data-tr="{{ content.id }}"><i class="icon-move"></i></a>{% endif %}</td>
                        {% endif %}
                        {% for index,row in content.td %}
                            {% if row.type == 'boolean' %}
                                <td style="vertical-align: middle;" class="text-center">
                                    {% if row.value == 1 %}
                                        <i class="icon-line-circle-check success"></i>
                                    {% else %}
                                        <i class="icon-line-circle-cross danger"></i>
                                    {% endif %}
                                </td>
                            {% elseif row.type == 'image' %}
                                <td style="vertical-align: middle;" class="text-center">
                                    {% if row.value != '' %}<img class="img-responsive" src="{{ row.value }}" style="max-height: 30px; max-width: 30px;" />{% endif %}
                                </td>
                            {% else %}

                                {% if row.module != '' and row.type != 'checkbox' %}
                                    <td style="vertical-align: middle;"><a style="display:inline-block;border-bottom:1px dashed #164757;" href="{{ route( row.module , 'edit' , '' , row.id ) }}">{{ row.value }}</a></td>
                                {% elseif row.type == 'checkbox' %}
                                    <td style="vertical-align: middle;">
                                        {% if row.value|length > 0 %}
                                            {% for rep in row.value %}{% if not loop.first %}, {% endif %}{% if rep.module != '' %}<a style="display:inline-block;border-bottom:1px dashed #164757;" href="{{ route( rep.module , 'edit' , '' , rep.id ) }}">{{ rep.value }}</a>{% else %}{{ rep.value }}{% endif %}{% endfor %}
                                        {% endif %}
                                    </td>
                                {% elseif row.subtype == 'email' %}
                                    <td style="vertical-align: middle;"><a style="display:inline-block;border-bottom:1px dashed #164757;" href="mailto:{{ row.value }}">{{ row.value }}</a></td>
                                {% elseif row.type == 'date' %}
                                    <td style="vertical-align: middle;">{{ row.value != '30/11/-0001' ? row.value : '-' }}</td>
                                {% elseif row.type == 'link' %}
                                    <td style="vertical-align: middle;">{% if row.value != '' %}<a style="" href="{{ row.value }}" target="_blank"><i class="icon-link"></i></a>{% endif %}</td>
                                {% elseif row.type == 'video' %}
                                    <td style="vertical-align: middle; text-align: center;">{% if row.value.link != '' %}<a style="" href="{{ row.value.link }}" target="_blank"><i class="icon-{{ row.value.source }}" style="color:#{{ row.value.color }};"></i></a>{% endif %}</td>
                                {% elseif row.style != '' %}
                                    <td style="vertical-align: middle;" class="text-center"><span class="{{ row.style }}">{{ row.value }}</span></td>
                                {% else %}
                                    <td style="vertical-align: middle;">{{ row.value }}</td>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                        {% if hasDefault %}
                            <td class="text-center" style="vertical-align: middle;">
                                {% if right.edit == true %}
                                    {% if content.default == 1 %}
                                        <span class="button button-rounded button-mini button-green">{{ _('by_default')}}</span>
                                    {% else %}
                                        <a class="default button button-rounded button-mini button-blue" href="{{ route( mod.name , 'default' , uri_id_parent , content.id , csrf_token ) }}">{{ _('set_default')}}</a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        {% endif %}
                        {% if hasValidation %}
                            <td class="text-center" style="vertical-align: middle;">
                                {% if right.validation == true %}
                                    <div class="switch text-center" data-urlenable="{{ route( mod.name , 'enable' , uri_id_parent , content.id , csrf_token ) }}" data-urldisable="{{ route( mod.name , 'disable' , uri_id_parent , content.id , csrf_token ) }}">
                                        <input id="switch-toggle-{{ content.id }}" class="switch-toggle switch-rounded-mini switch-toggle-round" name="active" type="checkbox"{{ content.validation == 1 ? ' checked' : '' }}>
                                        <label for="switch-toggle-{{ content.id }}"></label>
                                    </div>
                                {% else %}
                                    <i class="{{ content.validation == 1 ? 'icon-line2-check success' : 'icon-line-circle-cross danger' }}"></i>
                                {% endif %}
                            </td>
                        {% endif %}
                        <td class="text-right actionLink" style="vertical-align: middle;">
                            {% if content.icons|length > 0 and right.edit == true %}
                                {% for icon in content.icons %}
                                    {% if depedency %}
                                        <a href="{{ dRoute( mod.name , icon.action , dElement , dModule , content.id ) }}"{% if icon.blank %} target="_blank"{% elseif icon.ajax %} class="ajaxtable"{% else %} data-modal="true"{% endif %}><i class="{{ icon.class }}"></i></a>
                                    {% else %}
                                        <a href="{{ route( mod.name , icon.action , uri_id_parent , content.id ) }}"{% if icon.blank %} target="_blank"{% elseif icon.ajax %} class="ajaxtable"{% elseif icon.modal %} data-modal="true"{% endif %}><i class="{{ icon.class }}"></i></a>
                                    {% endif %}
                                {%  endfor %}
                            {% endif %}
                            {% if hasURL == true %}<a target="_blank" href="{{ content.url }}?preview={{ content.md5 }}&id={{ content.id }}"><i class="icon-line-link"></i></a>{% endif %}
                            {% if mod.canDuplicate == true %}
                                {% if depedency %}
                                    <a href="{{ dRoute( mod.name , 'duplicate' , dElement , dModule , content.id ) }}" class="duplicate"><i class="icon-files"></i></a>
                                {% else %}
                                    <a href="{{ route( mod.name , 'duplicate' , uri_id_parent , content.id ) }}" class="duplicate"><i class="icon-files"></i></a>
                                {% endif %}
                            {% endif %}
                            {% if right.edit == true and mod.canUpdate == true and content.edit == true %}
                                {% if depedency %}
                                    <a href="{{ dRoute( mod.name , 'edit' , dElement , dModule , content.id ) }}" data-modal="true"><i class="icon-pencil"></i></a>
                                {% else %}
                                    <a href="{{ route( mod.name , 'edit' , uri_id_parent , content.id ) }}"><i class="icon-pencil"></i></a>
                                {% endif %}
                            {% endif %}
                            {% if right.delete == true and mod.canDelete == true and content.delete == true %}<a href="{{ route( mod.name , 'delete' , '' , content.id , csrf_token ) }}" data-lightbox="ajax"><i class="icon-trash2"></i></a>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {# Outils d'actions massif #}
            {% if enableSelect %}
                <div class="action-massive" style="display:none;">
                    <button class="button button-black button-small" type="button" data-module-table-action-many-reverse><span>Inverser la sélection</span></button>
                    {% if hasValidation %}
                        <button class="button button-yellow button-rounded button-small" type="button" data-module-table-action-many-disable><span>Désactiver</span></button>
                        <button class="button button-green button-rounded button-small"  type="button" data-module-table-action-many-enable><span>Activer</span></button>
                    {% endif %}
                    {% if mod.canDelete %}
                        <a href="{{ route( mod.name , 'deleteMany' , '' , 0 , csrf_token ) }}"
                           class="button button-red button-rounded button-small"
                           type="button"
                           data-module-table-action-many-delete
                           data-lightbox="ajax"
                        ><span>Supprimer</span></a>
                    {% endif %}
                </div>
            {% endif %}

            {# Pagination #}
            {% if paginator|length > 0 %}
                <div style="float: right;">
                    <ul class="pagination">
                        {% for pages in paginator %}
                            {% if pages.num == '...' %}
                                <li class="page-item disabled">
                                    <span class="page-link">{{ pages.num }}</span>
                                </li>
                            {% else %}
                                <li class="page-item{{ pages.num == page ? ' active' : '' }}">
                                    <a class="page-link" href="javascript:;" data-page="{{ pages.num }}">{{ pages.num }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

        </div>

        {# No result #}
        {% if td|length == 0 %}
            <div class="sb-msg text-center" style="font-size: 16px; font-weight: bold;"><i class="icon-question-sign"></i>{{ _('no_result')}}</div>
        {% endif %}

    </form>
{% else %}
    <div class="style-msg" style="background-color: #eee;">
        <div class="sb-msg"><i class="icon-question-sign"></i>{{ _('no_content')}}</div>
    </div>
{% endif %}