{% if td|length > 0 or search == 1 %}
	<form action="{{ route( mod.name , 'table' , uri_id_parent ) }}" method="get" class="tableFormSearch" data-container="table-content-{{ mod.name }}">
		<div class="table-responsive">
			<table class="table table-striped table-hover{{ hasOrder ? ' table-dnd' : '' }}" id="table-{{ mod.name }}" data-name="{{ mod.name }}">
				<thead>
					<tr>
						{% if hasOrder and right.edit == true %}
							<th style="width: 50px;"></th>
						{% endif %}
						{% for thvalue in th %}
							<th>
								<span>{{ thvalue.title }}</span><br/>
                                {% if thvalue.type != 'image' %}
                                    <a data-filter data-by="desc" data-order="{{ thvalue.name }}" href="javascript:;" class="filter{% if order == thvalue.name and by == 'desc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="Trier par ordre décroissant"><i class="icon-chevron-sign-down"></i></a>
                                    <a data-filter data-by="asc" data-order="{{ thvalue.name }}" href="javascript:;" class="filter{% if order == thvalue.name and by == 'asc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="Trier par ordre croissant"><i class="icon-chevron-sign-up"></i></a>
                                {% else %}
                                    <br/>
                                {% endif %}
                            </th>
						{% endfor %}
                        {% if hasValidation %}
                            <th style="width: 100px;">
                                En ligne<br />
                                <a data-filter data-by="desc" data-order="{{ validationName }}" href="javascript:;" class="filter{% if order == validationName and by == 'desc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="Trier par ordre décroissant"><i class="icon-chevron-sign-down"></i></a>
                                <a data-filter data-by="asc" data-order="{{ validationName }}" href="javascript:;" class="filter{% if order == validationName and by == 'asc' %} active{% endif %}" data-toggle="tooltip" data-placement="top" title="Trier par ordre croissant"><i class="icon-chevron-sign-up"></i></a>

                            </th>
                        {% endif %}
                        <th class="text-right" style="width: 220px;">
							Afficher<select class="form-control form-control-sm inline" name="elmt_per_page" style="width: 75px; margin: 0 5px;">
								<option value="10" {{ elmt_per_page == '10' ? ' selected' : '' }}>10</option>
								<option value="25"{{ elmt_per_page == '25' ? ' selected' : '' }}>25</option>
								<option value="50"{{ elmt_per_page == '50' ? ' selected' : '' }}>50</option>
								<option value="100"{{ elmt_per_page == '100' ? ' selected' : '' }}>100</option>
								<option value="all"{{ elmt_per_page == 'all' ? ' selected' : '' }}>Tous</option>
							</select>éléments
						</th>

                    <tr class="trSearch">
						{% if hasOrder and right.edit == true %}
							<td style="width: 50px;"></td>
						{% endif %}
						{% for thvalue in th %}
							<td>
								{% if loop.first %}
									<input type="hidden" value="{{ order }}" name="order" class="tableOrderSearch" />
                                    <input type="hidden" value="{{ by }}" name="by" class="tableBySearch" />
                                    <input type="hidden" value="{{ page }}" name="page" class="tablePage" />
									<input type="hidden" value="1" name="search" />
								{% endif %}
								{% if thvalue.type == 'textarea' or thvalue.type == 'text' or thvalue.type == 'hidden' %}
									<input type="text" class="form-control form-control-sm" name="{{ thvalue.name }}" value="{{ thvalue.value }}" />
								{% elseif thvalue.type == 'date' %}
									<input type="text" class="form-control form-control-sm daterange" name="{{ thvalue.name }}" value="{{ thvalue.value }}" />
								{% elseif thvalue.type == 'number' %}
									<div class="input-group searchNumber">
										<input type="number" class="form-control form-control-sm" style="border-radius: 3px;" name="{{ thvalue.name }}_start" value="{{ thvalue.value_start }}" placeholder="De" />
									</div>
									<div class="input-group" style="margin-top: 2px;">
										<input type="number" class="form-control form-control-sm" style="border-radius: 3px;" name="{{ thvalue.name }}_end" value="{{ thvalue.value_end }}" placeholder="À" />
									</div>
								{% elseif thvalue.type == 'select' %}
                                    <select name="{{ thvalue.name }}" class="form-control form-control-sm" data-plugin-selectTwo>
                                        <option value=""{{ thvalue.value == '' ? ' selected' : '' }}>----- Aucune sélection -----</option>
                                        {% for key,value in thvalue.options %}
                                            <option value="{{ key }}"{{ key == thvalue.value ? ' selected' : '' }}>{{ value }}</option>
                                        {% endfor %}
                                    </select>
                                {% elseif thvalue.type == 'radio' and thvalue.boolean == true %}
                                    <select name="{{ thvalue.name }}" class="form-control form-control-sm" data-plugin-selectTwo>
                                        <option value=""{{ thvalue.value == '' ? ' selected' : '' }}>Tous</option>
                                        <option value="1"{{ thvalue.value == '1' ? ' selected' : '' }}>Oui</option>
                                        <option value="-1"{{ thvalue.value == '-1' ? ' selected' : '' }}>Non</option>
                                    </select>
                                {% endif %}
							</td>
						{% endfor %}
                        {% if hasValidation %}
                            <td></td>
                        {% endif %}
						<td class="text-right searchButton">
                            <button class="button button-rounded button-reveal button-small button-3d" type="submit"><i class="icon-search2"></i><span>Rechercher</span></button>
							{% if search == 1 %}<a class="button button-rounded button-reveal button-light button-white button-small button-3d initsearch" href="javascript:;"><i class="icon-repeat"></i><span>Réinitialiser</span></a>{% endif %}
						</td>
					</tr>
				</thead>
				<tbody>
				{% for content in td %}
					<tr class="tr1" data-parent-id="none" id="{{ content.id }}">
						{% if hasOrder and right.edit == true %}
							<td>{% if order == 'order' %}<a href="javascript:;" class="color-theme orderTable" data-tr="{{ content.id }}"><i class="icon-move"></i></a>{% endif %}</td>
						{% endif %}
						{% for index,row in content.td %}
                            {% if row.type == 'boolean' %}
                                <td style="vertical-align: middle;" class="text-center">
                                    {% if row.value == 1 %}
                                        <i class="icon-line-circle-check success"></i>
                                    {% else %}
                                        <i class="icon-line-circle-cross danger"></i>
                                    {% endif %}
                                </td>
                            {% elseif row.type == 'image' %}
                                <td style="vertical-align: middle;" class="text-center">
                                    <img class="img-responsive" src="{{ row.value }}" style="max-height: 30px; max-width: 30px;" />
                                </td>
                            {% else %}
                                {% if row.module != '' %}
                                    <td style="vertical-align: middle;"><a style="display:inline-block;border-bottom:1px dashed #164757;" href="{{ route( row.module , 'edit' , '' , row.id ) }}">{{ row.value }}</a></td>
                                {% elseif row.subtype == 'email' %}
                                    <td style="vertical-align: middle;"><a style="display:inline-block;border-bottom:1px dashed #164757;" href="mailto:{{ row.value }}">{{ row.value }}</a></td>
                                {% elseif row.type == 'date' %}
                                    <td style="vertical-align: middle;">{{ row.value != '30/11/-0001' ? row.value : '-' }}</td>
                                {% elseif row.type == 'link' %}

                                    <td style="vertical-align: middle;"><a style="" href="{{ row.value }}" target="_blank"><i class="icon-link"></i></a></td>
                                {% else %}
                                    <td style="vertical-align: middle;">{{ row.value }}</td>
                                {% endif %}
                            {% endif %}
						{% endfor %}
                        {% if hasValidation %}
                            <td class="text-center" style="vertical-align: middle;">
                                {% if right.validation == true %}
                                    <div class="switch text-center" data-urlenable="{{ route( mod.name , 'enable' , uri_id_parent , content.id , csrf_token ) }}" data-urldisable="{{ route( mod.name , 'disable' , uri_id_parent , content.id , csrf_token ) }}">
                                        <input id="switch-toggle-{{ content.id }}" class="switch-toggle switch-rounded-mini switch-toggle-round" name="active" type="checkbox"{{ content.validation == 1 ? ' checked' : '' }}>
                                        <label for="switch-toggle-{{ content.id }}"></label>
                                    </div>
                                {% else %}
                                    <i class="{{ content.validation == 1 ? 'icon-line2-check success' : 'icon-line-circle-cross danger' }}"></i>
                                {% endif %}
                            </td>
                        {% endif %}
						<td class="text-right actionLink" style="vertical-align: middle;">
                            {{ depedency }}
			                {% if content.icons|length > 0 and right.edit == true %}
                                {% for icon in content.icons %}
                                    {% if depedency %}
                                        <a href="{{ dRoute( mod.name , icon.action , dElement , dModule , content.id ) }}"><i class="{{ icon.class }}"></i></a>
                                    {% else %}
                                        <a href="{{ route( mod.name , icon.action , uri_id_parent , content.id ) }}"><i class="{{ icon.class }}"></i></a>
                                    {% endif %}
                                {%  endfor %}
                            {% endif %}
			                {% if hasURL == true %}<a target="_blank" href="{{ content.url }}"><i class="icon-line-link"></i></a>{% endif %}
                            {% if mod.canDuplicate == true %}
                                {% if depedency %}
                                    <a href="{{ dRoute( mod.name , 'duplicate' , dElement , dModule , content.id ) }}" class="duplicate"><i class="icon-files"></i></a>
                                {% else %}
                                    <a href="{{ route( mod.name , 'duplicate' , uri_id_parent , content.id ) }}" class="duplicate"><i class="icon-files"></i></a>
                                {% endif %}
                            {% endif %}
                            {% if right.edit == true %}
                                {% if depedency %}
                                    <a href="{{ dRoute( mod.name , 'edit' , dElement , dModule , content.id ) }}"data-modal="true"><i class="icon-pencil"></i></a>
                                {% else %}
                                    <a href="{{ route( mod.name , 'edit' , uri_id_parent , content.id ) }}"><i class="icon-pencil"></i></a>
                                {% endif %}
                            {% endif %}
                            {% if right.delete == true and mod.canDelete == true %}<a href="{{ route( mod.name , 'delete' , '' , content.id , csrf_token ) }}" data-lightbox="ajax"><i class="icon-trash2"></i></a>{% endif %}
						</td>
					</tr>
				{% endfor %}
				</tbody>
			</table>
            {% if paginator|length > 0 %}
                <div style="float: right;">
                    <ul class="pagination">
                    {% for pages in paginator %}
                        <li class="page-item{{ pages.num == '...' ? ' disabled' : '' }}{{ pages.num == page ? ' active' : '' }}"><a class="page-link" href="javascript:;" data-page="{{ pages.num }}">{{ pages.num }}</a></li>
                    {% endfor %}
                    </ul>
                </div>
            {% endif %}
		</div>
		{% if td|length == 0 %}
            <div class="sb-msg"><i class="icon-question-sign"></i>Aucun résultat</div>
		{% endif %}
	</form>
{% else %}
    <div class="style-msg" style="background-color: #eee;">
        <div class="sb-msg"><i class="icon-question-sign"></i>Il n'y a aucun contenu enregistré actuellement</div>
    </div>
{% endif %}