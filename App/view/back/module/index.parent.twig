<div class="fancy-title title-dotted-border topmargin-sm">
    <h3>{{ module.name }}</h3>
</div>
<div class="clearfix">

    <div class="col-md-2">
        <div class="feature-box fbox-center fbox-outline fbox-effect nobottomborder">
            <div class="fbox-icon">
                <a href="{{ route( module.class_name , 'add' , uri_id_parent ) }}"><i class="icon-line-plus i-alt"></i></a>
            </div>
            <h3 style="text-transform: none;">Ajouter un nouvel élément</h3>
        </div>
    </div>

    {% for row in content %}
        <div class="col-md-2" style="border: 1px solid #ddd;">
            <div class="feature-box fbox-center fbox-outline fbox-effect nobottomborder">
                <div class="fbox-icon">
                    <a href="{{ route( mod.name , 'index' , uri_id_parent ~ '/' ~ row.id ) }}"><i class="{{ module.icon }} i-alt"></i></a>
                </div>
                <h3 style="text-transform: none;">{{ row.name }}</h3>
                <a class="button button-3d button-small button-rounded">Sélectionner</a>
            </div>
        </div>
    {% endfor %}

    {% for row in content %}
        <div class="col-md-2 nopadding" style="border: 1px solid #ddd;">
            <div class="feature-box fbox-center fbox-outline fbox-effect nobottomborder">
                <div style="background: url('https://fakeimg.pl/260x130/') top center no-repeat; width: 100%; height: 130px; margin-bottom: 15px;"></div>
                <h3 style="text-transform: none;">{{ row.name }}</h3>
                <a class="button button-3d button-small button-rounded">Sélectionner</a>
            </div>
        </div>
    {% endfor %}

    <div class="clear"></div>

</div>