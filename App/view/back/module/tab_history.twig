{% if history|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th class="text-left">{{ _('date')}}</th>
                    <th class="text-left">{{ _('by')}}</th>
                    <th class="text-left" colspan="2">{{ _('type')}}</th>
                    <th class="text-left">{{ _('action')}}</th>
                </thead>
                <tbody>
                {% for row in history %}
                    <tr class="tr1" data-parent-id="none">
                        <td class="">{{ row.date }}</td>
                        <td style="vertical-align: middle">
                            {{ row.user.user_lname }} {{ row.user.user_fname }}
                        </td>
                        <td class="text-{% if row.type == 1 %}info{% elseif row.type == 2 %}warning{% elseif row.type == 3 %}alert{% endif %}" style="width: 10px; padding-right: 0;">
                            {% if row.type == 1 %}
                                <i class="icon-info-sign"></i>
                            {% elseif row.type == 2 %}
                                <i class="icon-warning-sign"></i>
                            {% elseif row.type == 3 %}
                                <i class="icon-remove-sign"></i>
                            {% endif %}
                        </td>
                        <td class="text-{% if row.type == 1 %}info{% elseif row.type == 2 %}warning{% elseif row.type == 3 %}alert{% endif %}" style="padding-left: 0;">
                            {% if row.type == 1 %}
                                {{ _('information')}}
                            {% elseif row.type == 2 %}
                                {{ _('danger')}}
                            {% elseif row.type == 3 %}
                                {{ _('alerte')}}
                            {% endif %}
                        </td>
                        <td class="">{{ row.msg }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
{% else %}
    <div class="style-msg" style="background-color: #eee;">
        <div class="sb-msg"><i class="icon-question-sign"></i>{{ _('no_historique')}}</div>
    </div>
{% endif %}