{% extends 'module.twig.html' %}

{% block title_page %}{{ _('grp_users') }}{% endblock %}
{% set this_page =  'Gestion'  %}

{% block module %}
	<div class="fancy-title title-dotted-border">
		<h3>{{ _('ufg_index_title') }}</h3>
	</div>

	<div class="ed-menu">
		<a href="{{ siteUrl('ext/user_front_group/edit') }}" class="button button-mini"><i class="icon-plus"></i> {{ _('button_add') }}</a>
	</div>
	<br /><br />
	<div class="clear"></div>

	<div class="table-responsive">
	{% if contentRows|length > 0 %}
		<table class="table table-striped table-search table-gestion table-ext table-hover mb-none">
			<thead>
				<tr>
					<th>{{ _('nom') }}</th>
					<th class="text-right" style="width: 220px"></th>
				</tr>
			</thead>
			<tbody>
			{% for row in contentRows %}
				<tr class="tr1">
					<td>
						<a href="{{ siteUrl('ext/user_front_group/edit/' ~  row.user_front_group_id) }}">{{ row.user_front_group_name }}</a>
					</td>
					<td class="text-right">
						<a href="{{ siteUrl('ext/user_front_group/edit/' ~ row.user_front_group_id) }}"><i class="icon-pencil"></i></a>
						<a data-lightbox="ajax" href="{{ siteUrl('ext/user_front_group/delete/' ~ row.user_front_group_id) }}"><i class="icon-trash2"></i></a>
					</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	{% else %}
		{% include 'form/generic/nocontent.twig' with {'msg':"Aucun groupe n'est enregistré."} %}
	{% endif %}
	</div>

{% endblock %}