{% extends 'module.twig.html' %}

{% block title_page %}{{ _('module_newsletter_planning')}}{% endblock %}
{% set this_page =  _('gestion') %}

{% block module %}
    <div class="fancy-title title-dotted-border">
        <h3>{{ _('module_newsletter_planning')}}</h3>
    </div>
    <div class="table-responsive">
        {% if contentRows|length > 0 %}
            <table class="table table-striped table-hover mb-none">
                <thead>
                <tr>
                    <th>{{ _('subject')}}</th>
                    <th>{{ _('dispatch_date')}}</th>
                    <th>{{ _('sender_sing')}}</th>
                    <th>{{ _('grp_destinataire')}}</th>
                    <th>{{ _('email_gabarit')}}</th>
                    <th>{{ _('type')}}</th>
                    <th>{{ _('parent_newsletter')}}</th>
                    <th>{{ _('status')}}</th>
                    <th class="text-right" style="width: 200px"></th>
                </tr>
                </thead>
                <tbody>
                {% for row in contentRows %}
                    <tr class="tr1">
                        <td>
                            {{ row.subject }}
                        </td>
                        <td>
                            {{ row.date | date("d/m/Y H:i:s") }}
                        </td>
                        <td>
                            {{ row.sender.name }}<br />
                            <small>{{ row.sender.email }}</small>
                        </td>
                        <td>
                            {% for i in row.recipient %}
                                {{ i.name }}{% if not.loop.last %},{% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {{ row.template.name }}
                        </td>
                        <td>
                            {{ row.type }}
                        </td>
                        <td>
                            {{ row.newsletter_parent.subject }}
                        </td>
                        <td>
                            {{ row.statut }}
                        </td>
                        <td class="text-right actionLink">
                            <a href="{{ siteUrl('/module/NewsletterCampaign/stats/0/id/') ~ row.id }}">
                                <i class="icon-bar-chart"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            {% include 'form/generic/nocontent.twig' with {'msg':'langue_index_msg' } %}
        {% endif %}
    </div>

{% endblock %}