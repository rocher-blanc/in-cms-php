{% extends 'module.twig.html' %}

{% block title_page %}Expéditeurs{% endblock %}
{% set this_page = 'Gestion' %}

{% block module %}
    <div class="fancy-title title-dotted-border">
        <h3>Liste des campagnes de newsletter</h3>
    </div>

    <div class="ed-menu marginbottom-sm">
        <a href="{{ siteUrl('ext/newsletter_campaign') }}" class="button button-mini"><i class="icon-th-list"></i> Gérer</a>
        <a href="{{ siteUrl('ext/newsletter_campaign/edit') }}" class="button button-mini"><i class="icon-plus"></i> Ajouter</a>
    </div>
    <br /><br />
    <div class="clear"></div>

    <div class="table-responsive">
        {% if true %}
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th>Sujet</th>
                    <th>Date de planification</th>
                    <th>Gabarit</th>
                    <th>Destinataires</th>
                    <th>Statut</th>
                    <th style="width: 300px"></th>
                </tr>
                </thead>
                <tbody>
                {% for i in 1..5 %}
                    {#{% for row in contentRows %}#}
                    <tr class="tr1">
                        <td>
                            {{ row.newsletter_campaign_subject }}
                        </td>
                        <td>
                            {{ row.newsletter_campaign_date }}
                        </td>
                        <td>
                            --
                        </td>
                        <td>
                            --
                        </td>
                        <td>
                            <span class="badge badge-info">En attente d'envoi</span>
                        </td>
                        <td class="text-right">
                            <a href="{{ siteUrl('ext/newsletter_sender/edit/' ~ row.newsletter_sender_id) }}"><i class="icon-pencil"></i></a>
                            <a data-lightbox="ajax" href="{{ siteUrl('ext/newsletter_sender/delete/' ~ row.newsletter_sender_id) }}"><i class="icon-trash2"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            {% include 'form/generic/nocontent.twig' with {'msg':"Aucun expéditeur n'est enregistré."} %}
        {% endif %}
    </div>
{% endblock %}