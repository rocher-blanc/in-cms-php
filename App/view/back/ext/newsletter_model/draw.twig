{% extends 'module.twig.html' %}

{% block title_page %}Modification d'un gabarit{% endblock %}
{% set this_page = 'Gestion' %}

{% block module %}
    <div class="fancy-title title-dotted-border">
        <h3>Modification d'un gabarit de newsletter</h3>
    </div>

    <div class="ed-menu marginbottom-sm">
        <a href="{{ siteUrl('ext/newsletter_model') }}" class="button button-mini"><i class="icon-th-list"></i> Gérer</a>
        <a href="{{ siteUrl('ext/newsletter_model/edit') }}" class="button button-mini"><i class="icon-plus"></i> Ajouter</a>
    </div>
    <br /><br />
    <div class="clear"></div>

    <div id="topolcontent"></div>
{% endblock %}

{% block stylesheets %}
<style>
	#topolcontent {
		height: 700px;
	}

	#leftPane {
		background-color: pink;
	}
</style>
{% endblock %}

{% block javascripts %}
<script>
    saveTemplate = function( html , redirect ) {
        $.ajax({
            type: "POST",
            url: '{{ siteUrl('ext/newsletter_model/save/' ~ id ) }}',
            data: $("meta[name=tokename]").attr("content") + '=' + $("meta[name=token]").attr("content") + '&html=' + html,
            success: function(data){
                if ( redirect ) {
                    document.location.href = '{{ siteUrl('ext/newsletter_model') }}';
                }
            },
            error: function(jqXHR, textStatus, errorThrown) {
                Notify(errorThrown, false);
            }
        });
    };

	$(function() {
		// Plugin Settings
        var TOPOL_OPTIONS = {
            id: "#topolcontent",
            authorize: {
                apiKey: "{{ apiKey }}",
                userId: "{{ userId }}"
            },
            language: "fr",
            templateId: {{ id }},
            onSaveAndClose: function(data) {
                // HTML of the email
                saveTemplate( data.html , true );
            },
            onSave: function(data) {
                // HTML of the email
                saveTemplate( data.html , false );
            },
        };

        // Plugin Start
        !function(t){var e=document.createElement("iframe");e.width="100%",e.height="100%",e.frameBorder="0",e.id="topolio-plugin",e.src="https://d5aoblv5p04cg.cloudfront.net/editor/plugin/index.html",document.querySelectorAll(t.id)[0].appendChild(e),e.addEventListener("load",function(){e.contentWindow.postMessage({action:"START",data:JSON.parse(JSON.stringify(t))},"*")}),window.addEventListener("message",function(e){var n=JSON.parse(e.data);"callback"==n.type&&"function"==typeof t[n.action]&&t[n.action](n.data)})}(TOPOL_OPTIONS);
	});
</script>
{% endblock %}