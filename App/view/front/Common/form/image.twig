<div>
    <img src="{{ value != '' ? image : siteUrl('assets/img/nophoto.jpg') }}" style="max-width: 100px;" />
</div>

{% set rand = random(1, 999999) %}

<input type="hidden" name="{{ name }}" id="id_{{ name }}" value="{{ value }}" />
<div class="{{ value != '' ? '' : 'hide' }}" id="field_show_{{ name }}_{{ rand }}">
    <a href="javascript:;" class="showfieldupload" data-field="field_upload_{{ name }}_{{ rand }}">{{ _('update_image') }}</a>
</div>
<div class="{{ value != '' ? 'hide' : '' }}" id="field_upload_{{ name }}_{{ rand }}">
    <input id="upload_{{ name }}_{{ rand }}" name="upload_{{ name }}" type="file"{# class="hide"#}>
    {#<button class="parcourir" data-input="upload_{{ name }}_{{ rand }}">{{ _('parcourir') }}</button>#}
</div>

