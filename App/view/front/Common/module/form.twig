{% if tabs|length > 1 %}
<div class="ed_element tabs tabs-bordered tabs-tb clearfix" data-active="1">
    <ul class="tab-nav clearfix">
        {% for tab in tabs %}
            <li{{ loop.first ? ' class="ui-tabs-active"' : '' }}>
                <a href="#tabs-{{ tab.key }}" id="onglet-{{ tab.key }}">
                    <i class="{{ tab.icon }}"></i> {{ tab.name }}
                </a>
            </li>
        {% endfor %}
    </ul>
    <div class="tab-container" id="form-module">
        {% endif %}

        <form method="post" action="{{ route }}" class="form-vertical" enctype="multipart/form-data" accept-charset="utf-8">
            <input type="hidden" name="id_element" value="{{ id != NULL ? id : '-1' }}" />
            <input type="hidden" name="moduleAction" value="1" />
            <input type="hidden" name="moduleName" value="{{ module }}" />
            <input type="hidden" name="keyControl" value="{{ keyControl }}" />
            {% for c in field if c.type == 'hidden' %}
                {{ c.Form_HTML }}
            {% endfor %}

            {% for tab in tabs %}
            {% set counter = 0 %}
            {% if tabs|length > 1 %}
            <div class="tab-content clearfix" id="tabs-{{ tab.key }}" data-onglet="onglet-{{ tab.key }}">
                {% else %}
                <div class="form-module">
                    {% endif %}
                    {% for c in field if c.tab == tab.key %}
                        {% if c.full != true %}
                            {% set counter = counter + 1 %}
                            {% if counter == 2 %}
                                {% set classCol = 'col_half col_last' %}
                                {% set counter = 0 %}
                            {% else %}
                                {% set classCol = 'col_half' %}
                            {% endif %}
                        {% else %}
                            {% set classCol = 'col_full' %}
                        {% endif %}
                        <div class="ed_field {{ classCol }}{% if c.error != '' %} error{% endif %}" id="field-{{ c.name }}">
                            <label>{{ c.title }}{% if c.required != '' %} <span class="icon-asterisk"></span>{% endif %}</label>
                            {% if c.comment != '' %}<div class="comment">{{ c.comment }}</div>{% endif %}
                            {{ c.Form_HTML }}
                        </div>
                    {% endfor %}

                    <div class="ed_field col_full">
                        <button class="ed-button button button-rounded button-reveal button-large button-3d"><i class="icon-save"></i><span>Enregistrer</span></button>
                    </div>
                    <div class="ed_field col_full">
                        <p class="ed-note"><strong>Note :</strong> veuillez remplir les champs marqués d'un <span class="icon-asterisk"></span></p>
                    </div>
                </div>
                {% endfor %}
        </form>

        {% if tabs|length > 1 %}
    </div>
</div>
{% endif %}