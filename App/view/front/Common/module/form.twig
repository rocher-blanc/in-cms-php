{% macro field(c, counter, width) %}
    <div class="ed_field {{ c.class }}{{ counter == width ? ' col_last' : '' }}{% if c.error != '' %} error{% endif %}{% if c.show == false %} hide{% endif %}" id="field-{{ c.name }}" data-field="{{ c.fieldname }}">
        <label>{{ c.title }}{% if c.required != '' %} <span class="icon-asterisk"></span>{% endif %}</label>
        {% if c.comment != '' %}<div class="comment">{{ c.comment }}</div>{% endif %}
        {{ c.Form_HTML }}
    </div>
{% endmacro field %}
{% import _self as form %}

{% if tabs|length > 1 %}
<div class="ed_element tabs tabs-bordered tabs-tb clearfix" data-active="1">
    <ul class="tab-nav clearfix">
        {% for tab in tabs %}
            <li{{ loop.first ? ' class="ui-tabs-active"' : '' }}>
                <a href="#tabs-{{ tab.key }}" id="onglet-{{ tab.key }}">
                    <i class="{{ tab.icon }}"></i> {{ tab.name }}
                </a>
            </li>
        {% endfor %}
    </ul>
    <div class="tab-container" id="form-module">
{% endif %}

    <form method="post" action="{{ route }}" class="form-vertical ajax" enctype="multipart/form-data" accept-charset="utf-8">
        <input type="hidden" name="id_element" value="{{ id != NULL ? id : '-1' }}" />
        <input type="hidden" name="moduleAction" value="1" />
        <input type="hidden" name="moduleName" value="{{ module }}" />
        <input type="hidden" name="keyControl" value="{{ keyControl }}" />
        {% for c in field if c.type == 'hidden' %}
            {{ c.Form_HTML }}
        {% endfor %}

