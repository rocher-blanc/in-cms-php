<!doctype html>
<html lang="fr">
    <head>
        <title>{{ _('nl_unsubscribe_title') }}</title>
        <meta charset="utf-8" />
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" rel="stylesheet">
        <link href="{{ asset('vendor/cmsmedias/front/css/newsletter.css') }}" rel="stylesheet">
    </head>
    <body>
        <form class="form-signin" style="background-color: #fff; border: 1px solid #eee; border-radius: 5px; padding: 50px 30px; max-width: 500px;" action="{{ siteUrl('/newsletter/unsubscribe/' ~ idnl ~ '/' ~ email ~ '/1') }}" method="get">
            <div class="text-center mb-4">
                <h1 class="h3 mb-3 font-weight-normal">{{ _('nl_unsubscribe_title') }}</h1>
            </div>
            {% if unsubscribe == false %}
                <div class="mb-4">
                    <p>{{ _('nl_unsubscribe_txt' , {
                        'name': newsletter_name
                    }) }}</p>
                </div>
                <a href="{{ siteUrl('/newsletter/unsubscribe/' ~ idnl ~ '/' ~ email ~ '/1') }}" class="btn btn-lg btn-primary btn-block" type="submit">{{ _('nl_unsubscribe_btn') }}</a>
            {% else %}
                {% if unsub == true %}
                    <div class="alert alert-success" role="alert">
                        {{ _('nl_unsubscribe_success') }}
                    </div>
                {% endif %}

                <div class="dropdown-divider"></div>

                <div class="checkbox mb-3 mt-3">
                    <label>
                        <input type="checkbox" name="all"> {{ _('nl_unsubscribe_all_newsletter') }}
                    </label>
                </div>
                <button class="btn btn-lg btn-primary btn-block" type="submit">{{ _('nl_unsubscribe_btn') }}</button>

            {% endif %}
        </form>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js"></script>
    </body>
</html>