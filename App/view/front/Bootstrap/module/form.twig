{% if tabs|length > 1 %}
<div class="clearfix" data-active="1">
    <ul class="nav nav-tabs">
        {% for tab in tabs %}
            <li class="nav-item">
                <a href="#tabs-{{ tab.key }}" class="nav-link {{ loop.first ? 'active' : '' }}" id="onglet-{{ tab.key }}">
                    <i class="{{ tab.icon }}"></i> {{ tab.name }}
                </a>
            </li>
        {% endfor %}
    </ul>
    <div class="tab-container" id="form-module">
{% endif %}

    <form method="post" action="{{ route }}" data-route-condition="" data-condition="{{ condition ? "true" : "false" }}" class="form-vertical ajax" enctype="multipart/form-data" accept-charset="utf-8">
        <input type="hidden" name="id_element" value="{{ id != NULL ? id : '-1' }}" />
        <input type="hidden" name="moduleAction" value="1" />
        <input type="hidden" name="moduleAction" value="1" />
        <input type="hidden" name="moduleName" value="{{ module }}" />
        <input type="hidden" name="keyControl" value="{{ keyControl }}" />
        <input type="hidden" name="noview" value="1" />
        {% if redirect != '' %}<input type="hidden" name="redirect" value="{{ redirect }}" />{% endif %}
        {% if timer != '' %}<input type="hidden" name="timer" value="{{ timer }}" />{% endif %}

        {% for c in field if c.type == 'hidden' %}
            {{ c.Form_HTML }}
        {% endfor %}

        {% for tab in tabs %}
            <div class="tab-content clearfix" id="tabs-{{ tab.key }}" data-onglet="onglet-{{ tab.key }}"{% if tab.show == false %} style="display: none;"{% endif %}>
                <div class="form-row">
                {% for c in field if c.tab == tab.key and c.type != 'hidden' and c.group == null %}

                    <div class="{% if c.class | length > 0 %}{{ c.class }}{% else %}col{% endif %}">
                        <div class="form-group">
                            {% include "module/field.twig" with { c:c, part:counter, numberOfPart:width } %}
                        </div>
                    </div>

                    {% if c.break %}
                        </div>
                        <div class="form-row">
                    {% endif %}

                {% endfor %}
                </div>
                {% if tab.group|length > 0 %}
                    {% for group in tab.group %}

                        <div class="form-row">
                            {% for c in field if c.tab == tab.key and c.type != 'hidden' and c.group == group.key %}
                                {% if loop.first %}
                                    <div class="col-12 text-center {{ group.show == false ? ' hide' : '' }}">
                                        <h3>{{ group.name}}</h3>
                                    </div>
                                {% endif %}

                                <div class="{% if c.class | length > 0 %}{{ c.class }}{% else %}col{% endif %}">
                                    <div class="form-group">
                                        {% include "module/field.twig" with { c:c, part:counter, numberOfPart:width } %}
                                    </div>
                                </div>

                                {% if c.break %}
                                    </div>
                                    <div class="form-row">
                                {% endif %}

                            {% endfor %}
                        </div>

                    {% endfor %}
                {% endif %}

                {% if recaptcha == true %}
                    <div class="row form-group">
                        <div class="col-12 text-center">
                            <div class="g-recaptcha" data-sitekey="{{ recaptcha_public_key }}"></div>
                        </div>
                    </div>
                {% endif %}

                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <p class="form-note"><strong>Note :</strong> veuillez remplir les champs marqués d'un <span class="icon-asterisk"></span></p>
                    </div>
                    <div class="col-sm-6 text-right">
                        <button class="btn btn-primary"><i class="icon-save"></i><span>Enregistrer</span></button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </form>

{% if tabs|length > 1 %}
    </div>
</div>
{% endif %}